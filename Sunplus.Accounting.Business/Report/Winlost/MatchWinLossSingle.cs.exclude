using System;
using System.Data;
using System.Text;
using IBCDLL.Report;
using DNAide.Core;
using DNAide.Data;
using DNAide.Web;
using System.Collections;
using IBCUtils;

/// <summary>
/// Summary description for MatchWinLossSingle
/// </summary>

namespace BLL.Report
{
    public class rptMatchWinLossSingle : ReportBase
    {
        private string REPORT_MatchWinLossSingle = "accRptMatchWinLossSingleBet." + AppSession.Username;

        public override string CreateHeader(Hashtable input)
        {
            string tpl = TemplateHandler.LoadTemplate("WinLost/MatchWinLostSingleBetAllHeader.htm");
            try
            {
                TemplateHandler.Assign(ref tpl, "{Title}", Resources.Language.MatchWinLostSingleBet);
                TemplateHandler.Assign(ref tpl, "{fdate}", Calendar.GenCalendarControl("fdate", "../", "fdateTrigger", FormatHandler.FormatDateEn(input["fdate"]), false, false, 3, 0, ""));
                TemplateHandler.Assign(ref tpl, "{tdate}", Calendar.GenCalendarControl("tdate", "../", "tdateTrigger", FormatHandler.FormatDateEn(input["tdate"]), false, false, 3, 0, ""));
                TemplateHandler.Assign(ref tpl, "{mainContent}", RenderHTML(input));
            }
            catch (Exception ex)
            {
                Logs.Write(ex.Message);
            }
            return tpl;
        }

        public override string RenderHTML(Hashtable input)
        {
            string tpl = TemplateHandler.LoadTemplate("WinLost/MatchWinLostSingleBetAllRow.htm");
            try
            {
                //Get data                       
                DbResult rs = MatchWinLossSingle.RptMatchWinLossDetailByMatch(CastAide.AsDateTime(input["fdate"]), CastAide.AsDateTime(input["tdate"]));
                DataRowCollection dtRow = rs.ResultSet.Tables[0].Rows;

                //Load Rows
                if (dtRow != null && dtRow.Count > 0)
                {
                    StringBuilder html = new StringBuilder();
                    string tpl_row = TemplateHandler.CopyBlock(tpl, "Rows");
                    string odd_even = "";
                    double total = 0;
                    foreach (DataRow dr in dtRow)
                    {
                        string row = tpl_row;
                        odd_even = (odd_even == "") ? "evenrow" : "";
                        TemplateHandler.Assign(ref row, "{odd_even}", odd_even);
                        TemplateHandler.Assign(ref row, "{home}", CacheRef.GetTeamName(dr["homeid"]) + (CastAide.AsBoolean(dr["isNeutral"]) ? ResourceExtension.GetResourceValue(ResourceExtension.Resources.Language, "IsNeutral") : string.Empty));
                        TemplateHandler.Assign(ref row, "{away}", CacheRef.GetTeamName(dr["awayid"]));
                        TemplateHandler.Assign(ref row, "{base}", FormatHandler.FormatNumber20((dr["matchwinlost"])));
                        html.Append(row);
                        total += FormatHandler.GetDouble(dr["matchwinlost"]);
                    }
                    string totalrow = Sunplus.Accounting.Core.Helper.WebUtils.LoadHtml("WinLost/MatchWinLostSingleBetTotal.htm", new string[] { "{total}" }, new string[] { FormatHandler.FormatNumber20(total) });
                    html.Append(totalrow);
                    TemplateHandler.ReplaceBlock(ref tpl, "Rows", html.ToString());
                }
                else
                {
                    string norow = TemplateHandler.LoadTemplate("NoInformation.htm");
                    TemplateHandler.Assign(ref norow, "{tdno}", "4");
                    TemplateHandler.Assign(ref norow, "{nodata}", ResourceExtension.GetResourceValue(ResourceExtension.Resources.Language, "thereisnodata"));
                    TemplateHandler.ReplaceBlock(ref tpl, "Rows", norow);
                }
            }
            catch (Exception ex)
            {
                Logs.Write(ex.Message);
            }

            SetCacheReport(REPORT_MatchWinLossSingle, tpl, DateTime.Now.AddMinutes(5));
            return tpl;
        }

        public override void Export2Excel(Hashtable input)
        {
            string data = GetCachedReport(this.REPORT_MatchWinLossSingle);
            if (string.IsNullOrEmpty(data))
            {
                RenderHTML(input);
                data = GetCachedReport(this.REPORT_MatchWinLossSingle);
            }
            data = "<table><tr><td>" + data + "</td></tr></table>";
            StringBuilder content = new StringBuilder();
            content.Append("<html>");
            content.Append("<head>");
            content.Append("<META http-EQUIV='Content-Type' CONTENT='text/html; charset=unicode-utf8'>");
            content.Append("</head>");
            content.Append(ReportHTML.CSSExcelReport());
            content.Append(data);
            content.Append("<table><tr><td class='tdhidden'></td></tr></table>");
            content.Append("</html>");

            ExcelContent = content.ToString();
            base.Export2Excel(input);
        }
    }

}
