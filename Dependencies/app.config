<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false" UMAddress="tcp://10.40.40.200:8989/LoadBalancerInterface" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline"> 
