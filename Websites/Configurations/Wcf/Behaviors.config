<?xml version="1.0"?>
<behaviors>
  <endpointBehaviors>
    <behavior name="WcfService">
      <webHttp/>
    </behavior>
    <behavior name="SpecialDeleteServiceBehavior">
      <!-- Max 5M -->
      <dataContractSerializer maxItemsInObjectGraph="5242880"/>
      <webHttp/>
    </behavior>
    <behavior name="SettlementService">
      <!-- Max 5M -->
      <dataContractSerializer maxItemsInObjectGraph="5242880"/>
      <webHttp/>
    </behavior>
  </endpointBehaviors>
  <serviceBehaviors>
    <behavior name="HelperServiceBehavior">
      <serviceMetadata httpGetEnabled="true"/>
      <serviceDebug includeExceptionDetailInFaults="false"/>
    </behavior>
    <behavior name="SpecialDeleteServiceBehavior">
      <serviceMetadata httpGetEnabled="true"/>
      <serviceDebug includeExceptionDetailInFaults="false"/>
    </behavior>
    <behavior name="ServiceHandlerBehavior">
      <serviceMetadata httpGetEnabled="true"/>
      <serviceDebug includeExceptionDetailInFaults="false"/>
    </behavior>
  </serviceBehaviors>
</behaviors>
