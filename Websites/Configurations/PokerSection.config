<?xml version="1.0"?>
<Poker>
  <DefaultSetting>
    <add name="supercom" min="0" max="0.67"></add>
    <add name="mastercom" min="0" max="0.67"></add>
    <add name="agentcom" min="0" max="0.67"></add>
    <add name="membercom" min="0" max="0.67"></add>
  </DefaultSetting>
  <CustomerSetting>
    <add name="visibleP2PStatus" value="true"></add>
    <add name="visibleP2PSetting" value="true"></add>
    <add name="group_1" value="Games"></add>
    <add name="group_2" value="Private Games"></add>
    <add name="stakes" value="Play for Fun|Low|Medium|High|VIP"></add>
    <add name="successMsg" value="Updated commission successfully.|Updated game setting successfully.|Updated bet setting successfully."></add>
  </CustomerSetting>  
</Poker>
