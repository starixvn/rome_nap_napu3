<?xml version="1.0" encoding="utf-8" ?>
<LiveCasinoSection>  
  <Report>
    <Items name="GameStatistics">
      <GameSearch>
        <!--company-->
        <filter id="-1" name="IBC" active="true" filtertype="Company" selected="true"></filter>
        <filter id="30" name="12Bet" active="false" filtertype="Company"></filter>
        <filter id="31" name="asiabet88" active="false" filtertype="Company"></filter>
        <filter id="34" name="mansion88" active="false" filtertype="Company"></filter>
        <!--/company-->
        
        <!--game type-->
        <filter id="1101" name="Baccarat" active="true" filtertype="GameType"></filter>
        <filter id="1102" name="Roulette" active="true" filtertype="GameType"></filter>
        <filter id="1103" name="Sicbo" active="true" filtertype="GameType"></filter>
        <!--/game type-->
        
        <!--game table-->
        <filter id="100" name="table 01" active="true" parent="1101;1102;1103" filtertype="GameTable"></filter>
        <filter id="101" name="table 02" active="true" parent="1101;1102;1103" filtertype="GameTable"></filter>
        <filter id="102" name="table 03" active="true" parent="1101;1102;1103" filtertype="GameTable"></filter>
        <filter id="103" name="table 04" active="true" parent="1101;1102" filtertype="GameTable"></filter>
        <!--/game table-->
      </GameSearch>

      <ReportType>
        <filter id="0" name="Daily" active="true"></filter>
        <filter id="1" name="Monthly" active="true"></filter>
        <filter id="2" name="Username" active="true"></filter>
        <filter id="3" name="Game type" active="true" selected="true"></filter>
        <filter id="4" name="Game table" active="true"></filter>
        <filter id="5" name="Company" active="true"></filter>
        <filter id="6" name="Currency" active="true"></filter>
      </ReportType>
    </Items>    
  </Report>
  <Setting>
    <Items>
      <Limits>
        <limit id="0" value="0" text="Unlimited" active="true"></limit>
        <limit id="10" value="10" text="10X" active="true"></limit>
        <limit id="5" value="5" text="5X" active="true"></limit>
        <limit id="3" value="3" text="3X" active="true"></limit>
      </Limits>
    </Items>
  </Setting>
</LiveCasinoSection>


