<?xml version="1.0" encoding="utf-8" ?>

<UserControl>
    <Report>
      <!--Racing-->
        <add alias="Racing" name="" db="">
            <stores>
              <add alias="12Bet" name="" function="ReportRacing12BET" site="12Bet"></add>
              <add alias="alog" name="" function="ReportRacingAlog" site="alog"></add>
              <add alias="asiabet88" name="" function="ReportRacingAsiabet88" site="asiabet88"></add>
              <add alias="Bezbet" name="" function="ReportRacingBezbet" site="Bezbet"></add>
              <add alias="mansion88" name="" function="ReportRacingMansion88" site="mansion88"></add>
              <add alias="Mayfair" name="" function="ReportRacingMayfair" site="Mayfair"></add>
              <add alias="spondemo" name="" function="ReportRacingSpondemo" site="spondemo"></add>              
              <add alias="SunGame" name="" function="ReportRacingSuncity" site="SunGame"></add>
              <add alias="TLC" name="" function="ReportRacingTLC" site="TLC"></add>
              <add alias="Zzun88" name="" function="ReportRacingZzun88" site="Zzun88"></add>              
            </stores>
        </add>
      
      <!--Licensee-->
      <add alias="Licensee" name="" db="">
        <stores>
          <add alias="12BET" name=""  function="ReportLicensee12BetWinLoss" site="12Bet" Level="3"></add>
          <add alias="asiabet88" name=""  function="ReportLicenseeFun88WinLoss" site="asiabet88" Level="2"></add>
          <add alias="mansion88" name=""  function="ReportLicenseeMansion88WinLoss" site="mansion88" Level="2"></add>
          <add alias="alog" name=""  function="ReportLicenseeALogWinLoss" site="alog" Level="2"></add>
          <add alias="spondemo" name=""  function="ReportLicenseeSpondemoWinLoss" site="spondemo" Level="2"></add>
          <add alias="TLC" name=""  function="ReportLicenseeTLCWinLoss" site="TLC" Level="2"></add>
          <add alias="DELA" name=""  function="ReportLicenseeDelaWinLoss" site="DELA" Level="2"></add>
          <add alias="Suncity" name=""  function="ReportLicenseeSuncityWinLoss" site="Suncity" Level="2"></add>
          <add alias="MayFair" name=""  function="ReportLicenseeMayfairWinLoss" site="MayFair" Level="2"></add>
          <add alias="Zzun88" name=""  function="ReportLicenseeZzun88WinLoss" site="Zzun88" Level="2"></add>
          <add alias="Bezbet" name=""  function="ReportLicenseeBezbetWinLoss" site="Bezbet" Level="2"></add>
          <add alias="Haifa" name=""  function="ReportLicenseeHaifaWinLoss" site="Haifa" Level="2"></add>
          <add alias="Bodog" name=""  function="ReportLicenseeBodogWinLoss" site="Bodog" Level="2"></add>
          <add alias="SG8" name=""  function="ReportLicenseeSG8WinLoss" site="SG8" Level="2"></add>
          <add alias="Tycoon" name=""  function="ReportLicenseeTycoonWinLoss" site="Tycoon" Level="2"></add>
          <add alias="Vwin" name=""  function="ReportLicenseeVwinWinLoss" site="Vwin" Level="2"></add>
        <add alias="Macaubet" name=""  function="ReportLicenseeMacaubetWinLoss" site="Macaubet" Level="2"></add>
			<add alias="Ibobet" name=""  function="ReportLicenseeIbobetWinLoss" site="ibobet" Level="2"></add>
          <add alias="VCAsia" name=""  function="ReportLicenseeVCAsiaWinLoss" site="VCAsia" Level="2"></add>
        </stores>
      </add>
    </Report>
</UserControl>

