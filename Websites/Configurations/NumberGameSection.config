<?xml version="1.0" encoding="utf-8" ?>

<NumberGameSection>
  <Bettype>
    <add name="Deadball" id="1" active="true" displayname="" >
      <Settings>
        <add name="1stLastOU" id="81" active="true" displayname="1st ball Over/ Under" blockname="1stLastOU-Key" issetting="true" ></add>
        <add name="LastOU" id="82" active="true" displayname="Last ball Over/ Under" blockname="LastOU-Key" issetting="false" ></add>
        <add name="1stLastOE" id="83" active="true" displayname="1st ball Odd/ Even"  blockname="1stLastOE-Key" issetting="true" ></add>
        <add name="LastOE" id="84" active="true" displayname="Last ball Odd/ Even" blockname="LastOU-Key" issetting="false" ></add>
        <add name="Warriror" id="88" active="true" displayname="Warrior"  blockname="Warriror-Key" issetting="true" ></add>
        <add name="DOddEven" id="86" active="true" displayname="FT. Odd/ Even"  blockname="DOE-Key" issetting="true" ></add>
      </Settings>
    </add>
    <add name="Liveball" id="2" active="true" displayname=""  >
      <Settings>
        <add name="OverUnder" id="85" active="true" displayname="Next Over/ Under" blockname="OU-Key" issetting="true" ></add>
        <add name="OddEven" id="86" active="true" displayname="Next Odd/ Even" blockname="OE-Key" issetting="true"></add>
        <add name="HighLow" id="87" active="true" displayname="Next Hight/ Low" blockname="HL-Key" issetting="true" ></add>
        <add name="NextCombo" id="89" active="true" displayname="Next Combo" blockname="NC-Key" issetting="true" ></add>
        <add name="NumberGroup" id="90" active="true" displayname="Number Group" blockname="NG-Key" issetting="true" ></add>
      </Settings>
    </add>
  </Bettype>

  <PTSetting>    
