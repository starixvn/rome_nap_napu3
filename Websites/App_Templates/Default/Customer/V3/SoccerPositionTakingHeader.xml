<table class="tblSporttypePT" width="{width}">
  <tr>
    <td class="l">
      <table border="1px" class="tblPT" width="100%" bordercolor="#CDCDCD">
        <!--super-auto-pt-->
        <tr style="display:{auto-none}">
          <td class="c" colspan="2">{autopresetposition}</td>
          <td class="l" colspan="10">
            <input onclick="CheckAutoPreset();"  type="checkbox" name="chkAutoPreset" id="chkAutoPreset"/>
          </td>
        </tr>
        <!--/super-auto-pt-->
        <!--min-max-pt-->
        <!--<tr class="pt-bgheader b">
          <td colspan="12" class="padd15">
            {bet-text}
          </td>
        </tr>-->        
        <tr>
          <td colspan="12">
            {BetSetting}
          </td>
        </tr>
        <tr class="pt-bgheader2 b">
          <td colspan="12" class="padd15">{PositionTaking}</td>
        </tr>
        <!--/min-max-pt-->
        <tr>
          <td colspan="{cols}" width="{pwidth}"></td>
          <td class="c">{handicap}</td>
          <td class="c">{overunder}</td>
          <td class="c">{1sthdp}</td>
