    <input type="button" name="listSPHdpB" value=" "   class="btn-dec1" onclick="ReducePT('listSPHdpB',1)"/>
    <input type="button" name="listSPHdpB" value=" "   class="btn-inc1" onclick="IncreasePT('listSPHdpB',1)"/>
    <input type="button" name="listSPHdpB" value=" " class="btn-dec10" onclick="ReducePT('listSPHdpB',10)"/>
