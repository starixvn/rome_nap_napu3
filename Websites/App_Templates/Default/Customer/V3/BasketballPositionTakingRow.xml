<tr>
  <td style="display:{none-tlposition}" class="right">{super-position}</td>
  <td>
    <select class="select-pt" name="listSHdpB{sporttype}" id="listSHdpB{sporttype}" onchange="On_ChangeSuper(this);">{listSHdpBValue}</select>
    <input type="button" name="btnReduce1"  value=" "   class="btn-dec1"  onclick="ReducePT('listSHdpB{sporttype}',1)"/>
    <input type="button" name="btnIncrease1" value=" "   class="btn-inc1" onclick="IncreasePT('listSHdpB{sporttype}',1)"/>
    <input type="button" name="btnReduce10" value=" " class="btn-dec10" onclick="ReducePT('listSHdpB{sporttype}',10)"/>
    <input type="button" name="btnIncrease10" value=" " class="btn-inc10" onclick="IncreasePT('listSHdpB{sporttype}',10)"/>
  </td>
  <td>
    <select class="select-pt" name="listSOUB{sporttype}" id="listSOUB{sporttype}" onchange="On_ChangeSuper(this);">{listSOUBValue}</select>
  </td>
  <td>
    <select class="select-pt" name="listSOEB{sporttype}" id="listSOEB{sporttype}" onchange="On_ChangeSuper(this);">{listSOEBValue}</select>
  </td>
  <!--no-mixparlays-->
  <td>
    <select class="select-pt" name="listSMPB{sporttype}" id="listSMPB{sporttype}" onchange="On_ChangeSuper(this);">{listSMPBValue}</select>
  </td>
  <!--/no-mixparlays-->
  <td>
    <select class="select-pt" name="listSMLB{sporttype}" id="listSMLB{sporttype}" onchange="On_ChangeSuper(this);">{listSMLBValue}</select>
  </td>
  <td rowspan="{rowspan}" class="left">
    <input type="checkbox" onclick="CopyPositionTaking(this);" name="chkCopyHdpB{sporttype}" id="chkCopyHdpB{sporttype}"/>
    Copy From Handicap
  </td>
</tr>
