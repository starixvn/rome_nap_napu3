<table width="75%" class="tblSporttypePT">	
	<tr>
		<td>
			<div id="divUpdInfo11" name="divUpdInfo11">
				<table width="100%" class="tbllayout" border="1">
					<tr class="title">					
						<td colspan="3">
							{bet-text}
						</td>
					</tr>
					<tr>
						<td class="r">{minbet-text}&nbsp;
							<input type="text" maxlength="14" id="txtMinbet11" name="txtMinbet11" value="{minbet11-val}"></input>					
							<span class="{mbMin}">&gt;=<span id="txtMinbet_Min11">{minbet-min-11}</span></span>
						</td>
						<td class="r">{maxbet-text}&nbsp;
							<input type="text" maxlength="14" id="txtMaxbet11" name="txtMaxbet11" value="{maxbet11-val}"></input>				
							<span class="{mbMax}">&lt;=<span id="txtMaxbet_Max11">{maxbet-max-11}</span></span>
						</td>
						<td class="r">{maxpermatch-text}&nbsp;
							<input type="text" maxlength="14" id="txtMaxPerMatch11" name="txtMaxPerMatch11" value="{maxpermatch11-val}"></input>					
							<span class="{mpmMin}">&gt;=<span id="txtMaxPerMatch_Min11">{maxpermatch-min-11}</span> and</span>
							<span class="{mpmMax}">&lt;=<span id="txtMaxPerMatch_Max11">{maxpermatch-max-11}</span></span>
						</td>
					</tr>				
				</table>
			</div>
		</td>
	</tr>	
	<tr>
		<td>
			<div id="divUpdPT11" name="divUpdPT11">
				<table border="1" width="100%" class="tbllayout">
					<tr class="title">
						<td colspan="{title-col}">{pt-text}</td>
					</tr>
					<!--none-edit-->
					<tr style="display:none">
						<td class="r">{auto-super-text}</td>
						<td colspan="5" class="l">
							<input type="checkbox" id="chkAuto11" onclick="CheckAutoPreset(this,arrDdl11);" name="chkAuto11"></input>
						</td>
					</tr>
					<!--/none-edit-->
					<tr class="title">
						<!--none-member--><td></td><!--/none-member-->
						<td>{hdp-text}</td>								
						<td>{ml-text}</td>
						<td></td>
					</tr>
					<tr>
						<!--none-member--><td class="r">{a-presetpt-text}</td><!--/none-member-->
						<td>{a-hdp-val}{a-hdp-btn}</td>										
						<td>{a-ml-val}</td>
						<td rowspan="{copy-hdp-col}" class="l"><input type="checkbox" {chk-hdp} id="chkCopy11Hdp" name="chkCopy11Hdp" onclick="CheckCopyPT(this,arrSuper11,arrMaster11,'{chkAuto-11}');"></input>
							{copy-hdp-text}</td>
					</tr>
					<!--none-member-->
					<tr>
						<td class="r">{p-presetpt-text}</td>
						<td>{p-hdp-val}{p-hdp-btn}</td>							
						<td>{p-ml-val}</td>
					</tr>
					<!--/none-member-->
					<!--auto-preset-->
					<tr class="{hdauto}">
						<td rowspan="2" class="r">{au-presetpt-text}</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this)" id="chkAuto11Hdp" name="chkAuto11Hdp" {checked-Hdp}></input>
						</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy11Hdp')" id="chkAuto11ML" name="chkAuto11ML" {checked-ML}></input>
						</td>
					</tr>
					<tr class="{hdauto}">
						<td>{au-hdp-val}&nbsp;{au-hdp-btn}</td>					
						<td>{au-ml-val}</td>
					</tr>
					<!--/auto-preset-->
				</table>
			</div>
		</td>
	</tr>
</table>

