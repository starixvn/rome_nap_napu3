<table width="75%" class="tblSporttypePT">	
	<tr>
		<td>
			<div id="divUpdInfo10" name="divUpdInfo10">
				<table border="1" width="100%" class="tbllayout">
					<tr class="title">					
						<td colspan="3">
							{bet-text}
						</td>
					</tr>
					<tr>
						<td class="r">{minbet-text}&nbsp;
							<input type="text" maxlength="14" id="txtMinbet10" name="txtMinbet10" value="{minbet10-val}"></input>					
							<span class="{mbMin}">&gt;=<span id="txtMinbet_Min10">{minbet-min-10}</span></span>
						</td>
						<td class="r">{maxbet-text}&nbsp;
							<input type="text" maxlength="14" id="txtMaxbet10" name="txtMaxbet10" value="{maxbet10-val}"></input>					
							<span class="{mbMax}">&lt;=<span id="txtMaxbet_Max10">{maxbet-max-10}</span></span>
						</td>
						<td class="r">{maxpermatch-text}&nbsp;
							<input type="text" maxlength="14" id="txtMaxPerMatch10" name="txtMaxPerMatch10" value="{maxpermatch10-val}"></input>					
							<span class="{mpmMin}">&gt;=<span id="txtMaxPerMatch_Min10">{maxpermatch-min-10}</span> and</span>
							<span class="{mpmMax}">&lt;=<span id="txtMaxPerMatch_Max10">{maxpermatch-max-10}</span></span>
						</td>
					</tr>				
				</table>
			</div>
		</td>
	</tr>	
	<tr>
		<td >
			<div id="divUpdPT10" name="divUpdPT10">
				<table border="1" width="100%" class="tbllayout">
					<tr class="title">
						<td colspan="{title-col}">{pt-text}</td>
					</tr>
					<!--none-edit-->
					<tr style="display:none">
						<td class="r">{auto-super-text}</td>
						<td colspan="5" class="l">
							<input type="checkbox" id="chkAuto10" onclick="CheckAutoPreset(this,arrDdl10);" name="chkAuto10"></input>
						</td>
					</tr>
					<!--/none-edit-->
					<tr class="title">
						<!--none-member--><td></td><!--/none-member-->
						<td>{hdp-text}</td>
						<td>{ou-text}</td>
						<td>{oe-text}</td>
						<td>{ml-text}</td>
						<td></td>
					</tr>
					<tr>
						<!--none-member--><td class="r">{a-presetpt-text}</td><!--/none-member-->
						<td>{a-hdp-val}{a-hdp-btn}</td>
						<td>{a-ou-val}</td>
						<td>{a-oe-val}</td>
						<td>{a-ml-val}</td>
						<td rowspan="{copy-hdp-col}" class="l">
							<input type="checkbox" {chk-hdp} id="chkCopy10Hdp" name="chkCopy10Hdp" onclick="CheckCopyPT(this,arrSuper10,arrMaster10,'{chkAuto-10}');"></input>
							{copy-hdp-text}
						</td>
					</tr>
					<!--none-member-->
					<tr>
						<td class="r">{p-presetpt-text}</td>
						<td>{p-hdp-val}{p-hdp-btn}</td>
						<td>{p-ou-val}</td>
						<td>{p-oe-val}</td>
						<td>{p-ml-val}</td>
					</tr>
					<!--/none-member-->
					<!--auto-preset-->
					<tr class="{hdauto}">
						<td rowspan="2" class="r">{au-presetpt-text}</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this)" id="chkAuto10Hdp" name="chkAuto10Hdp" {checked-Hdp}></input>
						</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy10Hdp')" id="chkAuto10OU" name="chkAuto10OU" {checked-OU}></input>
						</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy10Hdp')" id="chkAuto10OE" name="chkAuto10OE" {checked-OE}></input>
						</td>
						<td>
							<input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy10Hdp')" id="chkAuto10ML" name="chkAuto10ML" {checked-ML}></input>
						</td>
					</tr>
					<tr class="{hdauto}">
						<td>{au-hdp-val}&nbsp;{au-hdp-btn}</td>
						<td>{au-ou-val}</td>
						<td>{au-oe-val}</td>
						<td>{au-ml-val}</td>
					</tr>
					<!--/auto-preset-->
				</table>
			</div>
		</td>
	</tr>
</table>

