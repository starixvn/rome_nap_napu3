<table width="60%" class="tblSporttypePT">		
	<tr>
		<td >
			<div id="divUpdPT{sportId}" name="divUpdPT{sportId}">
				<table border="1" width="100%" class="tbllayout">
					<!--no-header-->
					<tr class="title">
						<td colspan="{title-col}">{pt-text}</td>
					</tr>
					<!--/no-header-->
					<tr>
						<!--none-edit-min--><td></td><!--/none-edit-min-->
						<td>{hdp-text}</td>
						<td>{ou-text}</td>					
						<td>{ml-text}</td>
						<!--limit-CopyHdp-->
						<td></td>
						<!--/limit-CopyHdp-->
					</tr>
					<!--none-Multi-->						
					<tr>
						
						<td class="r">{a-presetpt-text}</td>
						<td>{a-hdp-val}</td>
						<td>{a-ou-val}</td>					
						<td>{a-ml-val}</td>
						<!--limit-CopyHdp-->
						<td rowspan="{cols-a}"></td>
						<!--/limit-CopyHdp-->
					</tr>
					<!--none-Master-->
					<tr>
						<td class="r">{master-text}</td>
						<td>{m-hdp-val}</td>
						<td>{m-ou-val}</td>					
						<td>{m-ml-val}</td>
					</tr>
					<!--/none-Master-->
					<!--/none-Multi-->			
									
					<tr>
						<td class="r">{p-presetpt-text}</td>
						<td>{p-hdp-val}{p-hdp-btn}</td>
						<td>{p-ou-val}</td>					
						<td>{p-ml-val}</td>
						<!--limit-CopyHdp-->
						<td rowspan="{copy-hdp-col}" class="l">
							<input type="checkbox" {chk-hdp} id="chkCopy{sportId}Hdp" name="chkCopy{sportId}Hdp" onclick="CheckCopyPT(this,arrSuper{sportId});"></input>
							{copy-hdp-text}
						</td>
						<!--/limit-CopyHdp-->
					</tr>
					<!--none-Master-->		
					<!--none-edit-min-->					
					<tr>
						<td rowspan="2" class="r">{au-presetpt-text}</td>
						<td><input type="checkbox" onclick="CheckAutoPreset(this)" id="{chk1-Id}" name="{chk1-Id}" {checked-Hdp}></input></td>
						<td><input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy{sportId}Hdp')" id="{chk2-Id}" name="{chk2-Id}" {checked-OU}></input>	</td>				
						<td><input type="checkbox" onclick="CheckAutoPreset(this,'chkCopy{sportId}Hdp')" id="{chk3-Id}" name="{chk3-Id}" {checked-ML}></input></td>
					</tr>
					<tr>
						<td>{au-hdp-val}{au-hdp-btn}</td>
						<td>{au-ou-val}</td>					
						<td>{au-ml-val}</td>
					</tr>
					<!--/none-edit-min-->
					<!--/none-Master-->
				</table>
			</div>
		</td>
	</tr>
</table>

