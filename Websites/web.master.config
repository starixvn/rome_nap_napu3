  <BettingLimitMappingSection configSource="Configurations\CustomerSetting\BettingLimitMappingSection.config"/>
  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="222|152" authenticateFactory="Fanex.Tarus.Security.Authenticate.CustomerSettingAttribute, Fanex.Tarus.Security"/>
    <Keno enable="true" showsetting="false"/>
  </CustomerSetting>
  <AuthenticationFilter>
    <Security authenticateFactory="Fanex.Tarus.Security.Authenticate.SmartPunterAttribute, Fanex.Tarus.Security" deniedViewPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml"/>
  </AuthenticationFilter>
  <!--racing pt setting-->
  <PTRacingMappingSection configSource="Configurations\CustomerSetting\PTRacingMappingSection.config"/>
  <RacingBettingCommSettingMappingSection configSource="Configurations\CustomerSetting\RacingBettingCommSettingMappingSection.config"/>
