  <LiveCasinoSettings
       UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml"
       AuthorizationServiceType="Fanex.Tarus.Security.Authenticate.LiveCasinoAuthorizationService, Fanex.Tarus.Security"
       SystemId="1">
  </LiveCasinoSettings>
  <!--Fanex-->
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="Accounting-Local"/>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2, Fanex.Data" resourcePath="~/Configurations/StoreProcedureGroup" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <couchbase>
    <servers bucket="Accounting" bucketPassword="">
      <add uri="http://10.18.200.202:8091/pools/default"/>
      <add uri="http://10.18.200.207:8091/pools/default"/>
      <add uri="http://10.18.200.210:8091/pools/default"/>
    </servers>
  </couchbase>
  <!--Fanex-->
  <memcached protocol="Binary">
    <servers>
      <add address="10.18.200.209" port="11211"/>
    </servers>
    <socketPool minPoolSize="1" maxPoolSize="10" connectionTimeout="00:00:03" deadTimeout="00:00:03"/>
  </memcached>
