<LogsConfiguration>
  <Logs SensitiveParams="pass,pwd,security" SensitiveReplacement="*" UmURL="tcp://10.40.40.150:8990/UMControllerInterface" Site="AccountSite">    
    <Log type="Info">
      <Messages>
        <Message text="Thread was being aborted" />
      </Messages>
    </Log>
    <Log type="Warning">
      <Messages>
        <Message text="Not casino" />
        <Message text="Invalid attempt to read when no data is present" />
        <Message text="Input invalid at row" />
        <Message text="Cannot get a text value from" />
        <Message text="A potentially dangerous" />
        <Message text="The controller for path" />
        <Message text="A public action method" />
        <Message text="has been disconnected or does not exist at the server" />
        <Message text="Login failed for user" />
        <Message text="The input is not a valid Base-64 string" />
        <Message text="Cannot redirect after" />
        <Message text="The type initializer for 'DNAide.Web.TemplateHandler' threw an exception" />
      </Messages>
    </Log>
    <Log type="Critical">
      <Messages />
    </Log>
  </Logs>
</LogsConfiguration>