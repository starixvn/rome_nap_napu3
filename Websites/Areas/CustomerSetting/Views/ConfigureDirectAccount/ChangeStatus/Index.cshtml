@using Fanex.Tarus.Customer.Resources;
@using Fanex.Tarus.Customer.Entities;
@using Fanex.Tarus.Customer.Entities.ConfigureDirectAccount;
@model CustomerInfo
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Report/reportgrid.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
<link rel="stylesheet" type="text/css" href="~/Areas/CustomerSetting/Views/ConfigureDirectAccount/ChangeStatus/Styles/ChangeStatus.css" />
<div class="main">
    <div class="maincontent">
        <div id="result-message">
            @Customer_Labels.Symbol_Loading
        </div>
        <div id="setting-content" class="display-none">
            <div>
                @Html.Raw(Customer_Labels.ConfigureDirectAccount_ViewEffectMessage)
            </div>
            @Html.Partial("~/Areas/CustomerSetting/Views/ConfigureDirectAccount/ChangeStatus/UpdateDirectAccountStatusEffect.cshtml")
            <table id="table-button-group"  cellspacing="0" cellpadding="0" border="0">
                <tr>
                    <td>
                        <input id="button-update" type="button" class="hand btn" value="@Customer_Labels.OK" />
                    </td>
                    <td>
                        <input id="button-cancel" type="button" class="hand btn" value="@Customer_Labels.Cancel" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/jQuery/json2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/js/BlockUI.js"></script>
    <script type="text/javascript" src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js"></script>
    <script type="text/javascript" src="~/Areas/CustomerSetting/Views/ConfigureDirectAccount/ChangeStatus/Scripts/ChangeStatusManager.js"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var custInfo = {
            Username:'@Model.UserName',
            CustomerId: '@Model.CustId',
            IsCheckedDirectStatus: @(Model.DirectAccountStatusInfo.IsCheckedDirectStatus ? 1 : 0)
        };

        var viewResources = {
            Error_SystemError: '@Customer_Labels.Error_SystemError',
            Message_NoData: '@Customer_Labels.Message_NoData'
        };
    </script>
</div>
