@using Fanex.Tarus.Customer.Resources;
<div id="update-effect-container" class="freegrid display-none">
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="col40 c table-cell" style="height: 29px;">
                                @Customer_Labels.Symbol_No</div>
                        </th>
                        <th>
                            <div class="col160 c table-cell">
                                @Customer_Labels.Username</div>
                        </th>
                        <th>
                            <div class="col80 c table-cell">
                                @Customer_Labels.Status</div>
                        </th>
                        <th>
                            <div class="col80 c table-cell">
                                @Customer_Labels.Position</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="update-effect-content" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="col40 c table-cell" style="height: 29px;">
                                @Customer_Labels.Symbol_No</div>
                        </th>
                        <th>
                            <div class="col160 c table-cell">
                                @Customer_Labels.Username</div>
                        </th>
                        <th>
                            <div class="col80 c table-cell">
                                @Customer_Labels.Status</div>
                        </th>
                        <th>
                            <div class="col80 c table-cell">
                                @Customer_Labels.Position</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
