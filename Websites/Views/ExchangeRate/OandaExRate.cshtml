<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
   <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="~/js/common.js" type="text/javascript"></script>
     <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
    <script src="~/js/BlockUI.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script> 
    <script src="~/js/Datetime.js" type="text/javascript"></script>
    <script src="~/js/jQuery/gridscroller.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/ExchangeRate/Scripts/OandaExRate.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
   
    <script type="text/javascript" src="~/js/common.js"></script>
    <title></title>
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                    </td>
                    <td class="maincontent_headerC">
                       OANDA Exchange Rate
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div class="maincontent_box" style="width: 565px;">
                <table>
                    <tr>
                        <td>
                            From:
                        </td>
                        <td style="width: 120px">
                           <input type="text" id="txtfromdate" readonly="readonly" class="txtdate" style="width: 100px;" />
                        </td>
                         <td>
                            To:
                        </td>
                        <td style="width: 120px">
                           <input type="text" id="txttodate" readonly="readonly" class="txtdate" style="width: 100px;" />
                        </td>
                        <td align="left">
                            <input type="button" class="btn" onclick="OANDAExRate.LoadDataOANDAExRate()" value="Submit"
                                name="btnShow" id="btnShow" />
                        </td>
                        
                    </tr>
                </table>
               <br />
                <div style="font-weight:bold">Please note that this report is using OANDA exchange rate for currency conversion</div>
            </div>
            
            <div id="mainreport" style="padding-top: 2px">
                <div id="OANDAExRate" class="content-warper hidden">
                    <div class="content-toolbox bgtitle">
                        <div id="gridTitle" class="gridtitle">
                        </div>
                        <div class="btngroup">
                            <input type="button" onclick="OANDAExRate.exportExcelOANDAExRate()" value="  " name="btnExport"
                                id="exportExcel" class="btnExcel" title="Export to Excel" />
                        </div>
                    </div>
                    <div class="content-header clearfix">
                        <div class="header-scroll">
                            <table class="tbl-header-scroll" id="tblcontent">
                                <tr>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col120 c">Date
                                        </div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col140 c">
                                            Currency Code</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col140 c">
                                            EUR/Unit</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col140 c">
                                            USD/Unit</div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="content-body clearfix">
                        <div class="body-scroll">
                            <table id="tblOANDAExRate" class="tbl-body-scroll">
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
   @{
       if(Request["isExport"] != null && Request["isExport"] == "1")
       {
           string fdate = Request["fdate"].ToString();
           string tdate = Request["tdate"].ToString();
           new Fanex.Tarus.ExchangeRate.Controller.ExchangeRateController().ExportExcelExDailyOanda(fdate, tdate);
       }
    }
   <script type="text/javascript">      
       var today = '@DateTime.Now.ToShortDateString().ToString()';
   </script>
</body>
</html>
