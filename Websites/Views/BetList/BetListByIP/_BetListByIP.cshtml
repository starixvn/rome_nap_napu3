                <thead>
                    <tr>
                        <th>
                            <div class="width30 height34 table-cell">
                                No</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Trans.Time</div>
                        </th>
                        <th>
                            <div class="width350 height34 table-cell">
                                Choice</div>
                        </th>
                        <th>
                            <div class="width80 height34 table-cell">
                                Odds</div>
                        </th>
                        <th>
                            <div class="width80 height34 table-cell">
                                Stake</div>
                        </th>
                        <th>
                            <div class="width80 height34 table-cell">
                                Win Loss</div>
                        </th>
                        <th>
                            <div class="width80 height34 table-cell">
                                Status</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Operator</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        betdetail = Model[0];
                        @MvcHtmlString.Create(renderResult[1])
                    }
                    else
                    { 
                        <tr class="c">
                            <td colspan="11" class='r'>
                                <div class="c b">
                                    There is no data.
                                </div>
                            </td>
                        </tr>
                        betdetail.Ticket = new Ticket { CustId = 0 };
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="col_footer row-footer-background scroll-y">
        <div class="footer-container">
            <table id="GridFooterCol" class="grid-fixed-table col_footer_content">
                <thead>
                    <tr class="event">
                        <th class="none-border-right">
                            <div class=" height17 table-cell" style="width: 511px;">
                                &nbsp;</div>
                        </th>
                        <th>
                            <div class=" height17 table-cell r" style="width: 165px;">
                                @{
                                    string subTotalTmp = totalWinlost > 0 ? "SubTotal (win)" : "SubTotal (loss)";
                                }
                                @subTotalTmp</div>
                        </th>
                        <th>
                            <div class="@betlistHelper.IsNegative(totalWinlost) height17 table-cell r width80">
                                @totalWinlost.Format(2)</div>
                        </th>
                        <th>
                            <div class=" height17 table-cell" style="width: 205px;">
                                &nbsp;</div>
                        </th>
                    </tr>
                    <tr class="event">
                        <th class="none-border-right">
                            <div class=" height17 table-cell" style="width: 511px;">
                                &nbsp;</div>
                        </th>
                        <th>
                            <div class=" height17 table-cell r" style="width: 165px;">
                                SubTotal (com)</div>
                        </th>
                        <th>
                            <div class="@betlistHelper.IsNegative(totalComm) height17 table-cell r width80">
                                @totalComm.Format(2)</div>
                        </th>
                        <th>
                            <div class=" height17 table-cell" style="width: 205px;">
                                &nbsp;</div>
