@using Fanex.BetList.Accounting.Models;
@using Fanex.BetList.Accounting.Core;
@using Fanex.BetList.Accounting.Extensions;
@{
    var betdetail = Model;
    string statusTemp = betdetail.Ticket.Status.ToLower();
    BetListHelper betlistHelper = new BetListHelper();

    decimal PT = betdetail.Ticket.SuperPositionTaking;
    decimal PT2 = betdetail.SuperPositionTaking2;
    decimal discount = betdetail.Ticket.SuperDiscount;
    decimal comm = betdetail.Ticket.SuperComm;
    decimal winlost = betdetail.Ticket.SuperWinlost;
    string doubleCom = betdetail.Ticket.CommStatus == "1" ? "2x" : string.Empty;
   
}
@if (betlistHelper.IsHRWinPlaceBettype(betdetail.Ticket.BetTypeId))
{
    <div class="blue">
        <span>Win: </span><span class="b">@betlistHelper.PercentFormat(PT)
        </span>
    </div>
    <div class="margin-top-5">
        <span>Place: </span><span class="b">@betlistHelper.PercentFormat(PT2)</span></div>
}
else
{
    <div class="@betlistHelper.IsNegative(PT)">
        @*casino, bingo*@
        @if (betdetail.Ticket.BetTypeId == 71 || betdetail.Ticket.BetTypeId == 73)
        {

        }
        else
        {
            <span>@betlistHelper.PercentFormat(PT)</span>
        }
    </div>
}
@if (statusTemp != "running")
{
    <div class="@betlistHelper.IsNegative(winlost) margin-top-5">
        @winlost.Format(2)
    </div>
}
<div class="margin-top-5">
    @*casino, bingo*@
    @if (betdetail.Ticket.BetTypeId == 71 || betdetail.Ticket.BetTypeId == 73)
    {

    }
    else
    {
        <span>@doubleCom @betlistHelper.PercentFormat(discount)</span>
    }
</div>
@if (statusTemp != "running")
{
    <div class="margin-top-5">
        @comm.Format(2)
    </div>
}