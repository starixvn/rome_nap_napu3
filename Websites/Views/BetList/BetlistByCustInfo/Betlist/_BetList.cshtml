@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Core.Entities;
@using Fanex.BetList.Accounting.Core;
@using Fanex.BetList.Accounting.Extensions;
@using DNAide.Core;

@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    TicketDetail betdetail = new TicketDetail();
    int NumberBegining = ViewBag.NumberBegining;
    long[] arrTransID = new long[Model.Count];

    string[] renderResult = Render(ref NumberBegining, ref arrTransID);
}
@functions {
    public string[] Render(ref int NumberBegining, ref long[] arrTransID)
    {
        string[] result = new string[2];
        int i = 0;
        foreach (var betdetail in Model)
        {
            if (betdetail.Ticket.BetTypeId == 73 || betdetail.Ticket.BetTypeId == 71 || betdetail.Ticket.SportTypeId == 202)
            {
                betdetail.Ticket.TransId = CastAide.AsInt64(betdetail.Ticket.RefNo);
            }
            result[1] += renderContent(betdetail, NumberBegining);
            arrTransID[i++] = betdetail.Ticket.TransId;
            NumberBegining++;
        }
        return result;
    }
}
@helper renderContent(TicketDetail betdetail, int NumberBegining)
    {
    <tr class="c">
        <td>
            <div class="c width30 table-cell">
                @NumberBegining
            </div>
        </td>
        <td class="c">
            <div class="width120 table-cell">
                <div class="refno ">
                    @if (betdetail.Ticket.BetTypeId == 73 || betdetail.Ticket.BetTypeId == 71 || betdetail.Ticket.SportTypeId == 202)
                    {
                        <span>Ref No: @betdetail.Ticket.RefNo </span>
                    }
                    else
                    {
                        <span>Ref No: @betdetail.Ticket.TransId </span>
                    }
                </div>
                <div class="c">
                    @betdetail.Ticket.TransDate</div>
            </div>
        </td>
        <td id ="td_right_@betdetail.Ticket.TransId"  class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="width275 table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
                @if (betdetail.Ticket.BetTypeId == 9 || betdetail.Ticket.BetTypeId == 29)
                {
                    <div class="parlay_@betdetail.Ticket.TransId ">
                    </div>
                }
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_Odds.cshtml", betdetail)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width50 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_WinLoss.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div id="stautus_@betdetail.Ticket.TransId" class="width100 table-cell">
                @Html.Raw(betdetail.StatusHtml)
                @{
                    var ip = @Sunplus.Accounting.Business.IpManagement.ReplaceVNIP(betdetail.Ticket.IP);
                }
                @if (ip != "-")
                {
                    <br />
                    <a href="@Url.Action("BetListByIP", "TarusBetList", new { IsLink = true, FromDate = betdetail.Ticket.WinlostDate.ToString("MM/dd/yyyy"), IP = betdetail.Ticket.IP })">@ip</a>
                }
            </div>
        </td>
        <td class="r">
            <div id="comm_@betdetail.Ticket.TransId" class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_SuperPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_MasterPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_AgentPTCom.cshtml", betdetail)
            </div>
        </td>
    </tr>
 
}
