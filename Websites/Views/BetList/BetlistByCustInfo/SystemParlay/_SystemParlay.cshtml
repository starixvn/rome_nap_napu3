@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Core.Entities;
@using Fanex.BetList.Accounting.Extensions;
@using Fanex.BetList.Accounting.Core;
@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    TicketDetail betdetail = new TicketDetail();
    int NumberBegining = ViewBag.NumberBegining;
    long[] arrTransID = new long[Model.TicketsDetailList.Count];
    string[] renderResult = Render(ref NumberBegining, ref arrTransID);
}
@functions {
    public string[] Render(ref int NumberBegining, ref long[] arrTransID)
    {
        string[] result = new string[2];
        int i = 0;
        foreach (var betdetail in Model.TicketsDetailList)
        {
            result[1] += renderContent(betdetail, NumberBegining);
            arrTransID[i++] = betdetail.Ticket.TransId;
            NumberBegining++;
        }
        return result;
    }
}
@helper renderContent(TicketDetail betdetail, int NumberBegining)
    {
    <tr class="c">
        <td>
            <div class="c width30 table-cell">
                @NumberBegining
            </div>
        </td>
        <td class="c">
            <div class="width120">
                  <div class="refno ">
                    @if (betdetail.Ticket.BetTypeId == 71)
                    {
                        <span>No: @betdetail.Ticket.RefNo </span>
                    }
                    else
                    {
                        <span>Ref No: @betdetail.Ticket.TransId </span>
                    }
                </div>
                <div class="c">
                    @betdetail.Ticket.TransDate</div>
            </div>
        </td>
        <td id ="td_right_@betdetail.Ticket.TransId"  class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="width270  table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
                @if (betdetail.Ticket.BetTypeId == 9 || betdetail.Ticket.BetTypeId == 29)
                {
                    <div class="parlay_@betdetail.Ticket.TransId">
                    </div>
                }
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_Odds.cshtml", betdetail)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width50 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_WinLoss.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div id="stautus_@betdetail.Ticket.TransId" class="width100 table-cell">
             @Html.Raw(betdetail.StatusHtml)
                 @{
                     var ip = @Sunplus.Accounting.Business.IpManagement.ReplaceVNIP(betdetail.Ticket.IP);
                }
                @if (ip != "-")
                {
                    <br />
                    <a href="@Url.Action("BetListByIP", "TarusBetList", new { IsLink = true, FromDate = betdetail.Ticket.WinlostDate.ToString("MM/dd/yyyy"), IP = betdetail.Ticket.IP })">@ip</a>
                }
            </div>
        </td>
        <td class="r">
            <div id="comm_@betdetail.Ticket.TransId" class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_SuperPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_MasterPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_AgentPTCom.cshtml", betdetail)
            </div>
        </td>
        <td>
            <div class="width30 table-cell">
                @if (betdetail.AllowDelete == false || betdetail.Ticket.BetTypeId == 1102 || betdetail.Ticket.BetTypeId == 1103 || betdetail.Ticket.BetTypeId == 1000)
                {
                    <span>&nbsp;</span>
                }
                else
                {
                    <span id="delete_@betdetail.Ticket.TransId" class="delete_button"  onclick="confirm_delete(@betdetail.Ticket.TransId, '@betdetail.BetFrom', '@betdetail.Ticket.MatchId', @betdetail.Ticket.BetTypeId)" onmouseout="" onmouseover="this.style.cursor='pointer';">
                    </span> 
                }</div>
        </td>
    </tr>
 
}
<div id="BetlistSystemParlay" class="freegrid display-none">
    <div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content ">
                <thead>
                    <tr>
                        <th>
                            <div class="width30 height34 table-cell">
                                No</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Date</div>
                        </th>
                        <th>
                            <div class="width270 height34 table-cell">
                                Choice</div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Odds</div>
                        </th>
                        <th>
                            <div class="width50 height34 table-cell">
                                Stake</div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Win Loss</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                Status</div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Super
                                <br />
                                PT/Comm</div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Master
                                <br />
                                PT/Comm</div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Agent
                                <br />
                                PT/Comm</div>
                        </th>
                        <th>
                            <div class="width30 height34 table-cell">
                                Del</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TicketsDetailList.Count > 0)
                    {
                        betdetail = Model.TicketsDetailList[0];
                        @MvcHtmlString.Create(renderResult[1])
                    }
                    else
                    { 
                        <tr class="c">
                            <td colspan="11" class='r'>
                                <div class="c b">
                                    There is no data
                                </div>
                            </td>
                        </tr>
                        betdetail.Ticket = new Ticket { CustId = 0 };
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@if (Model.TicketsDetailList.Count > 0)
{
    @Html.Partial("~/Views/BetList/BetlistByCustInfo/SystemParlay/_EventDetail.cshtml")
}
<script type="text/javascript">

   var _arrayTransID = @serializer.Serialize(arrTransID);
    var _length = @ViewBag.Quantity;
</script>
