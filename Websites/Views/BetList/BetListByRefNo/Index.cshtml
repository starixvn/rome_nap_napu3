<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css" />
</head>
<body>
    <div class="main">
        <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
            <tr>
                <td>
                    <div id="divMainHeader" class="">
                        <div id="left_tab1">
                            <ul>
                                <li class="lefticon"></li>
                                <li class="current"><span>Bet List</span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="maincontent" style="">
                        <div class="filterBox">
                            <div class="filterContent">
                                <div id="filter" style="border: none !important; width: 100%;">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <div>
                                                        <span style="width: 50px; font-weight: bold; text-align: right;">Ref No</span></div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <input id="txtRefNo" maxlength="19" type="text" style="background-color: #fff; width: 100px;" autocomplete="off" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="margin-left: 5px;">
                                                        <input class="btn" type="button" id="btnReport" value="Submit" onclick="BetList.GetBetListByRefNo()" />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div id="err" style="display: none">
                                    </div>
                                </div>
                                <div class="b" style="color: #6E6E6E;">Note: Casino/Bingo/Keno tickets are not supported to view on this bet list.</div>
                            </div>
                        </div>
                        <div id="betListContent" style="margin-top: 10px;">
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
     <div id="Popup" style="display:none"></div>
    <script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
 
    head.js("@Url.Content("~/js/jQuery/jquery.js")",
            "@Url.Content("~/js/json2.js")", 
            "@Url.Content("~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1")",
            "@Url.Content("~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js")",
            "@Url.Content("~/js/IBCWnd/IBCWnd.js")", 
            "@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js")",
            "@Url.Content("~/js/BlockUI.js")", 
            "@Url.Content("~/js/dialogbox.js")",
            "@Url.Content("~/js/common.js")", 
            "@Url.Content("~/js/BetList.js")",
            "@Url.Content("~/Views/BetList/BetListByRefNo/Scripts/BetListByRefNo.js?ver=34")",
            "@Url.Content("~/Views/BetList/Scripts/BetlistGlobal.js?ver=34")");
    </script>
</body>
</html>
