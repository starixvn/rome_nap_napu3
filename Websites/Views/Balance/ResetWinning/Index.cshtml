@{
    Page.Title = "Reset Winning";
    //Layout = "Your Layout Page goes here";
}
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
    type="text/css" />
<link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
<link href="~/Views/Balance/ResetWinning/Style/ResetWinning.css" rel="stylesheet"
    type="text/css" />
<script src="~/js/jQuery/json2.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/BlockUI.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
<script src="~/js/Datetime.js" type="text/javascript"></script>
<script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
<script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
<script src="~/Views/Balance/ResetWinning/Script/ResetWinning.js" type="text/javascript"></script>
<div class="main">
    <div class="maincontent">
        <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
            <tr>
                <td class="maincontent_headerL">
                </td>
                <td class="maincontent_headerC">
                    Reset Winning
                </td>
                <td class="maincontent_headerR">
                </td>
            </tr>
        </table>
        <div id="errMsg" class="errMsg hidden">
        </div>
        <div class="maincontent_box w525">
            <table>
                <tr>
                    <td>
                        Time Period
                    </td>
                    <td>
                        <select id="chkTimePeriod" class="w150">
                            <option id="0" value="0">Since Last Move-Bet Day</option>
                            <option id="1" value="1">Specific Date</option>
                        </select>
                    </td>
                    <td>
                        Date
                    </td>
                    <td style="width: 120px">
                        <input type="text" id="txtfromdate" readonly="readonly" class="txtdate w100" disabled="disabled"/>
                    </td>
                    <td align="left">
                        <input type="button" class="btn" value="View Report" name="btnViewReport" id="btnViewReport" />
                    </td>
                </tr>
            </table>
        </div>
        <div id="reportContainer">
            <div id="resetWinningForSpecificDay" class="content-warper hidden">
                <div class="content-header clearfix">
                    <div class="header-scroll">
                        <table class="tbl-header-scroll" id="tblcontent">
                            <tr>
                                <td style="border-bottom: none 0px;">
                                    <div class="col140 c">
                                    </div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        Win/Loss</div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        Reset</div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        Variance</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="content-body clearfix">
                    <div class="body-scroll">
                        <table id="tblResetWinningForSpecificDay" class="tbl-body-scroll">
                        </table>
                    </div>
                </div>
            </div>
            <div id="resetWinningForSpecificDayAfterMoveBetDay" class="content-warper hidden">
                <div class="content-header clearfix">
                    <div class="header-scroll">
                        <table class="tbl-header-scroll" id="tblcontent">
                            <tr>
                                <td style="border-bottom: none 0px;">
                                    <div class="col140 c">
                                    </div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        Win/Loss</div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        <input type="button" class="btn" value="Reset" name="btnReset" id="btnResetWinning" class="hidden"/>
                                        <div id="lblReset" class="hidden">Reset</div>
                                    </div>
                                </td>
                                <td style="border-bottom: none 0px;">
                                    <div class="col120 c">
                                        Variance</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="content-body clearfix">
                    <div class="body-scroll">
                        <table id="tblResetWinningForSpecificDayAfterMoveBetDay" class="tbl-body-scroll">
                        </table>
                    </div>
                </div>
            </div>
            <div id="resetWinningSinceLastMoveBetDay" class="content-warper hidden">
                <div class="content-header clearfix">
                    <div class="header-scroll">
                        <table class="tbl-header-scroll">
                            <tr style="width: 525px;">
                                <td>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="content-body clearfix">
                    <div class="body-scroll">
                        <table id="tblresetWinningSinceLastMoveBetDay" class="tbl-body-scroll">
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var serverTime = '@DateTime.Now.ToShortDateString()';
    var currdate = new Date(serverTime);
    var minDate = '@Sunplus.Accounting.DataAccess.Report.ReportUtils.BalanceUp.BalanceUpDay.ToShortDateString()';
    var moveBetDay = '@Sunplus.Accounting.DataAccess.Report.ReportUtils.BalanceUp.MoveBetsDay.ToShortDateString()';
    var lastMoveDay = '@Sunplus.Accounting.DataAccess.Report.ReportUtils.BalanceUp.MoveBetsDay.AddDays(1).ToShortDateString()';
    var chosenDate = '@DateTime.Now.AddDays(-1).ToShortDateString()';
    var today = '@DateTime.Today.ToShortDateString()';
    var hasPermissionToReset = ParseToBoolean('@ViewBag.HasPermission');
</script>
