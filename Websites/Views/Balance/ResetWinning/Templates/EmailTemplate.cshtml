@model Fanex.Tarus.Balance.Entities.ResetWinning_New
<div>
    <div style="color: #000000;">
        Dear All,<br /><br />
        Please be informed that Balance of @Model.WinLossDate was reset by @Model.UserReset with following information:
    </div>
    <br/>
   <table cellspacing="0" rules="all" border="1" id="display" style="border-color:#c5c5c5; border-style:Solid;border-collapse:collapse;font-size:9pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
        <caption style="line-height:28px; text-align: left; font-weight: bold; background-color:#8DB4E2; color:#FFFFFF;"><div>@Model.WinLossDate</div></caption>
        <thead>
            <tr style="height: 25px;background-color:#CDDEF3; color: #000000; font-weight: bold;">
                <th style="width:200px;"></th>
                <th style="width:150px;">Win/Loss</th>
                <th style="width:150px;">Total Reset</th>
                <th style="width:150px;">Latest Reset</th>
                <th style="width:150px;">Variance</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.ReportRows.Count; i++)
            {
                var item = Model.ReportRows[i];
                string bgClass = string.Empty;
                if (i % 2 == 0)
                {
                    bgClass = string.Empty;
                }
                else
                {
                    bgClass = "background-color: #cddef3";
                }
                
                if (item.Product.ToLower() == "racing (due to partners)" || item.Product.ToLower() == "poker (due to partners)")
                {
                    bgClass = "background-color: #DADADA";
                }
                if (item.Product.ToLower() == "others")
                {
                    bgClass = "background-color: #D8E4BB";
                }
                
                <tr style="height: 25px; color: #000000; @bgClass">
                    <td style="text-align:left; font-weight: bold">@item.Product</td>
                    <td style="text-align:right;">@item.WinLoss_Str</td>
                    <td style="text-align:right;">@item.Reset_Str</td>
                    <td style="text-align:right;">@item.LatestReset_Str</td>
                    <td style="text-align:right;">@item.Variance_Str</td>
                </tr>
            }
            @if (Model != null)
            {
                <tr style="height: 25px; background-color:#C3D79B; font-weight:bold; color: #000000;">
                    <td colspan="4" style="text-align:left;">Total</td>
                    <td style="text-align:right;">@Model.Variance_Str</td>
                </tr>
            }
        </tbody>
   </table>
   <br />
    <div style="color: #000000; font-style:italic">
        This is an auto-generated email, please do not reply.<br /><br />
        Thanks & Regards,<br /><br />
        Automail System.
    </div>
</div>
