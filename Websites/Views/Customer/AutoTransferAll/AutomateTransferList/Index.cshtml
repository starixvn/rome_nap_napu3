<!DOCTYPE html>
<html>
<head>
    <title>Auto transfer all</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/Customer/AutoTransferAll/Style/AutoTransferAll.css" />
</head>
<body>
    <div id="mainDiv" class="main">
        <div class="maincontent">
            <div id="boxheader">
                <div class="left_tab">
                    <ul>
                        <li class="current" id="autoTransferTab"><a><span>Automate Transfer List</span></a></li>
                        <li id="addAgemtTab"><a  href="@Url.Action("AddAgent", "AutoTransferAll")"><span>Upload Agent</span></a></li>
                    </ul>
                </div>
            </div>
            <div id="maincontent_betlist" class="maincontent_box">
                <div>
                    <span>Username :</span>
                    <input id="txtUsername" type="text" />
                    <span>Status </span>
                    <select id="ddlFilterStatus" name="ddlFilterStatus">
                        <option value="">All</option>
                        <option value="Waiting">Waiting</option>
                        <option value="Running">Running</option>
                        <option value="Completed">Completed</option>
                        <option value="Failed">Failed</option>
                    </select>
                    <input class="btn" type="button" id="btnSearch" value="Search" />
                    <input class="btn" type="button" id="btnAddAgent" value="Add Agent" />
                </div>
            </div>
            <div id="err">
            </div>
            <div id="autoTransferDiv">
            </div>
        </div>
    </div>
    <div id="dialogConfirm" style="display: none;">
        <table id="tblconfirm">
            <tr>
                <td colspan="2">
                    <div id="errPopup">
                    </div>
                </td>
            </tr>
            <tr>
                <td style="font-weight: bold;">
                    User Name
                </td>
                <td>
                    <textarea id="usernamesTextarea" maxlength="4000" rows="3" cols="55">&nbsp;</textarea>
                    <span>
                        Enter user names, seperates by ','</span>
                </td>
            </tr>
            <tr>
                <td style="font-weight: bold;">
                    Transfer Type
                </td>
                <td>
                    <select id="ddlTranferTypePopup" style="color: Blue;" name="ddlTranferTypePopup">
                        <option value="1" style="color: blue;">Transfer All Members</option>
                        <option value="2" style="color: Green;">Transfer All DownLines</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <div id="dialogConfirmDeleted" style="display: none;">
        <div id="tblconfirmDeleted">
        </div>
    </div>
     <div id="dialogConfirmUpdated" style="display: none;">
        <div id="tblconfirmUpdated">
        </div>
    </div>
    <script type="text/javascript" src="~/js/jQuery/jquery-1.7.js"></script>
    <script type="text/javascript" src="~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js"></script>
    <script type="text/javascript" src="~/js/jQuery/Pager/jpager.js"></script>
    <script type="text/javascript" src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=15"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/js/BlockUI.js"></script>
    <script type="text/javascript" src="~/Scripts/Namespace.js"></script>
    <script type="text/javascript" src="~/Views/Customer/AutoTransferAll/Scripts/AutomateTransferList.js"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var menuHeight = window.parent.document.getElementById("submenu").clientHeight - 33;
        $('#mainDiv').css({ 'margin-top': menuHeight });
    </script>
</body>
</html>
