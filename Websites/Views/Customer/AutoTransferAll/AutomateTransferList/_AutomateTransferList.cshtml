                </thead>
                <tbody>
                    @if (Model.AutoTransfers.Count > 0)
                    {
                        @MvcHtmlString.Create(result)
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div style="text-align: center;" class="height20 r">
