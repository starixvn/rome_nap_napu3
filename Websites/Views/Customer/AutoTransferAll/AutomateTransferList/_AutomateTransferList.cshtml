                        <th>
                            <div class="width60 height34 table-cell">
                                User Role</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                Super</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                Master</div>
                        </th>
                        <th>
                            <div class="width150 height34 table-cell">
                                Transfer Type</div>
                        </th>
                        <th>
                            <div class="width150 height34 table-cell">
                                Lastest AutoTransfer Log</div>
                        </th>
                        <th>
                            <div class="width80 height34 table-cell">
                                Status</div>
                        </th>
                        <th>
