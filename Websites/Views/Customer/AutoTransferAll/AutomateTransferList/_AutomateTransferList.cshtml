@using Fanex.Tarus.Customer.Entities.AutoTransferAll
@{
    string result = string.Empty;
    foreach (AutoTransfer autoTransfer in Model.AutoTransfers)
    {
        result += renderContent(autoTransfer);
    }
}
@functions {
    public string SplitUsername(string username)
    {
        if (username.Length < 15)
        {
            return username;
        }

        string usernameTmp = username;
        string firstSubstring = usernameTmp.Substring(0, 15);
        string secondSubstring = usernameTmp.Substring(15, username.Length - 15);
        return firstSubstring + "<br />" + secondSubstring;
    }
 }
@helper renderContent(AutoTransfer autoTransfer)
    {
        var bg = (autoTransfer.No % 2 == 0) ? "even" : "";
        string isFailed = autoTransfer.StatusName.Trim().ToLower().Equals("failed") ? "red" : "";
        string isDisabled = autoTransfer.StatusName.Trim().ToLower().Equals("failed") ? "" : "disabled";
        string transferTypeColor = autoTransfer.TransferType == 1 ? "blue" : "green";
        
        string tooltip = string.Empty;
        string transferTypeSymbol = autoTransfer.TransferType == 1 ? " (M) " : " (D) ";
        string status = string.IsNullOrEmpty(autoTransfer.StatusName) ? string.Empty : autoTransfer.StatusName + transferTypeSymbol;
        switch(autoTransfer.StatusName.Trim().ToLower() )
        {
            case "failed":
                tooltip = "Failed (D): Auto transfer status = Failed; Transfer type = Transfer all Downlines. \n Failed (M): Auto transfer status = Failed; Transfer type = Transfer all Members.";
                break;
            case "waiting":
                tooltip = "Waiting (D): Auto transfer status = Waiting; Transfer type = Transfer all Downlines. \n Waiting (M): Auto transfer status = Waiting;Transfer type = Transfer all Members.";
                break;
            case "running":
                tooltip = "Running (D): Auto transfer status = Running; Transfer type = Transfer all Downlines. \n Running (M): Auto transfer status = Running; Transfer type = Transfer all Members.";
                break;
            default:
                tooltip = "Complete (D): Auto transfer status or manual transfer status = Complete; Transfer type = Transfer all Downlines. \n Complete (M): Auto transfer status = Complete; Transfer type = Transfer all Members.";
                break;
        }
        
    <tr id="tr_@autoTransfer.No" class="@bg">
        <td>
            <div class="width30 table-cell c height20">
                @autoTransfer.No
            </div>
        </td>
        <td class="">
            <div class="width100 table-cell" style="height: 20px; text-overflow:ellipsis;">
                 @MvcHtmlString.Create(SplitUsername(autoTransfer.UserName))
            </div>
        </td>
        <td>
            <div class="width60 table-cell ">
                @autoTransfer.UserRole
            </div>
        </td>
        <td>
            <div class="width100 table-cell" style="height: 20px; text-overflow:ellipsis;">
                  @MvcHtmlString.Create(SplitUsername(autoTransfer.SuperName)) 
            </div>
        </td>
        <td>
            <div class="width100 table-cell" style="height: 20px; text-overflow:ellipsis;">
              @MvcHtmlString.Create(SplitUsername(autoTransfer.MasterName)) 
            </div>
        </td>
        <td>
            <div class="width150 table-cell c">
                <select id="ddlTranferType_@autoTransfer.CustId" style="color: @transferTypeColor;" name="ddlTranferType" onChange="automateTransferAll.updatedTransfer('@autoTransfer.UserName',@autoTransfer.CustId);">
                    @if(autoTransfer.TransferType == 1){
                    <option value="1" style="color: blue;" selected="selected">Transfer All Members</option>
                    <option value="2" style="color: Green;">Transfer All DownLines</option>
                        }
                        else{
                          <option value="1" style="color: blue;">Transfer All Members</option>
                    <option value="2" style="color: Green;" selected="selected">Transfer All DownLines</option>
                        }
                </select>
            </div>
        </td>
        <td>
            <div class="width150 table-cell c">
           @if(!string.IsNullOrEmpty(autoTransfer.StatusName))
           {
                @autoTransfer.LastestAutoTransferLog
               }
            </div>
        </td>
        <td class="c">
            <div class="width80 table-cell c @isFailed" id="status_@autoTransfer.CustId"  title="@tooltip">
                @status
            </div>
        </td>
        <td>
            <div class="width100 table-cell c">
                <input @isDisabled class="btn" type="button" id="btnTransferAll_@autoTransfer.CustId" value="Transfer All" onclick="automateTransferAll.confirmClearBalance('@autoTransfer.UserName',@autoTransfer.CustId);" />
                &nbsp;
            </div>
        </td>
        <td>
            <div class="width50 table-cell c">
                <span id="delete_@autoTransfer.CustId" class="delete_button"  onclick="automateTransferAll.confirmDeletedTransfer('@autoTransfer.UserName',@autoTransfer.CustId);">
                </span>
            </div>
        </td>
    </tr>
}
