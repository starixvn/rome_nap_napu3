<script type="text/javascript">
    var viewResources = {
        ThereIsNoData: "There is no data!"
    };

    var sportsbookSports = [];
   (function () { 
       @{
            @:var sport;
            var sports = SportsSection.Instance.Sports;
            foreach (SportsElement sportElement in sports)
            {
                if (!sportElement.Active ||
                    string.Equals(sportElement.Id, Sports.NumberGame.ToString()))
                {
                    continue;
                }

                @:sport = { Id: '@sportElement.Id.ToLower()', BetTypes: []};
                if (!string.IsNullOrWhiteSpace(sportElement.Bettype.Trim()) &&
                    sportElement.Bettype != "NA")
                {
                    var betTypes = sportElement.Bettype.Split(new char[] { ',' });
                    foreach (var betType in betTypes)
                    {
                        @:sport.BetTypes.push(@betType);
                    }
                }
                
                @:window.sportsbookSports.push(sport);
            }
        }
   })();
   
    var racingToteTypes = [];
   (function () { 
        var racing;
        var tote;
        @{
            var racings = RacingSection.Instance.Racings;
            foreach (RacingElement racingElement in racings)
            {
                if (!racingElement.Active)
                {
                    continue;
                }

                @:racing = { Id: "@racingElement.Id" , Totes: [] };
                foreach (ToteElement tote in racingElement.Totes)
                {
                    if (!tote.Active)
                    {
                        continue;
                    }

                    @:tote = {Id: @tote.Id, BetTypes: []};   
                     if (!string.IsNullOrWhiteSpace(tote.BetType) &&
                         tote.BetType != "NA")
                     {
                         var betTypes = tote.BetType.Split(new char[] { ',' });
                         foreach (var betType in betTypes)
                         {
                             @:tote.BetTypes.push(@betType);
                         }
                     }
                                          
                    @:racing.Totes.push(tote);
                }

        @:window.racingToteTypes.push(racing);
            }
       }
   })();

   var numberGameBetTypes = [];
   (function () { 
    @{
        sports = SportsSection.Instance.Sports;
        foreach (SportsElement sportsElement in sports)
        {
            if (!string.Equals(sportsElement.Id.Trim(), Sports.NumberGame.ToString()) ||
                string.IsNullOrWhiteSpace(sportsElement.Bettype) ||
                sportsElement.Bettype == "NA")
            {
                continue;
            }

            var betTypes = sportsElement.Bettype.Split(new char[] { ',' });
            foreach (var betType in betTypes)
            {
                @:window.numberGameBetTypes.push(@betType);
            }
        }
    }

   })();
</script>
<script type="text/javascript" src="~/Views/Customer/DepositCustomer/EditLicensee/Scripts/PositionTakingRenderManager.js?version=@WebSettings.Version"></script>
