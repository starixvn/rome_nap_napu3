@helper GenerateSportsbook_NumberGameSettings()
    {
        var sports = SportsSection.Instance.Sports;
        foreach (SportsElement sport in sports)
        {
            if (!sport.Active ||
                string.Equals(sport.Id, Sports.NumberGame.ToString()))
            {
                continue;
            }

            var attributeIsSoccer = "";
            attributeIsSoccer = string.Equals(sport.Id, Sports.Soccer.ToString()) ?
                "soccer='true'" :
                "remainsport='true'";

            var minBetv = "minbetv" + @sport.Id.ToLower();
            var maxBetv = "maxbetv" + @sport.Id.ToLower();
            var maxPerMatchv = "maxpermatchv" + @sport.Id.ToLower();       
            
    <tr>
        <td class="column-sportname">
            <span>@sport.Name</span>
        </td>
        <td>
            <input id="@minBetv" minbet="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Minbet" />
        </td>
        <td>
            <input id="@maxBetv" maxbet="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Maxbet" />
        </td>
        <td>
            <input id="@maxPerMatchv" maxpermatch="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Maxpermatch" />
        </td>
    </tr>
        }
}
@helper GenerateRacingSettings()
    {
        var racings = RacingSection.Instance.Racings;
        foreach (RacingElement racing in racings)
        {
            if (!racing.Active)
            {
                continue;
            }

            var isFirst = true;
            var activeCounter = 0;
            foreach (ToteElement tote in racing.Totes)
            {
                if (tote.Active)
                {
                    activeCounter++;
                }
            }

            foreach (ToteElement tote in racing.Totes)
            {
                var flat = "";
                if (string.Equals(racing.Id, Sports.HorseRacing.ToString()) &&
                    string.Equals(tote.Id, BetType.WinUKTote.ToString()))
                {
                    flat = "copyfrom";
                }
                else
                {
                    flat = "copyto";
                }

                var minBetId = "v" + racing.Id.ToLower() + "minbet_" + tote.Id;
                var maxBetId = "v" + racing.Id.ToLower() + "maxbet_" + tote.Id;
                var maxpermatchId = "v" + racing.Id.ToLower() + "maxpermatch_" + tote.Id;
                var commId = "v" + racing.Id.ToLower() + "discount_" + tote.Id;
                var winplaceId = "v" + racing.Id.ToLower() + "spositiontaking_" + tote.Id;
                var horseAutoId = "v" + racing.Id.ToLower() + "ibcpositiontaking_" + tote.Id;
                var disableId = "disable" + racing.Id.ToLower() + "_" + tote.Id;
    <tr>
        @if (isFirst && activeCounter != 0)
        {
            isFirst = false;
            <td rowspan="@activeCounter" class="bettypename" align="left">
                <span>@racing.Name</span>
            </td>
        }
        @if (!tote.Active)
        {
            continue;
        }
        <td class="totename">
            <span>@tote.Name</span>
        </td>
        <td>
            <input id="@minBetId" @flat type="text" minbet="true" class="betsetting" value="@tote.Minbet" />
        </td>
        <td>
            <input id="@maxBetId" @flat type="text" maxbet="true" class="betsetting" value="@tote.Maxbet" />
        </td>
        <td>
            <input id="@maxpermatchId" @flat type="text" maxpermatch="true" class="betsetting" value="@tote.Maxpermatch" />
        </td>
        <td class="align-center">
            <select id="@commId" @flat comm="true"  class="dropdown-commission">
            </select>
        </td>
        <td class="align-center">
            <select id="@winplaceId" @flat winplacept="true" class="dropdown-position">
            </select>
        </td>
        <td class="align-center">
            <select id="@horseAutoId" @flat houseautopt="true" class="dropdown-position">
            </select>
        </td>
        <td class="align-center">
            <input id="@disableId" @flat type="checkbox" />
            <label class="label-for-checkbox" for="@disableId">
                Enable</label>
        </td>
    </tr>
            }
        }
}
