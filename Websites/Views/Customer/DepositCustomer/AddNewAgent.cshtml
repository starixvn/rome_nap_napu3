    dataJson.KenoBetTypesSettingInfo = dataJson.KenoBetTypesSettingInfo.replace(/&quot;/g, '"');
    dataJson.KenoBetTypesSettingInfo = jQuery.parseJSON(dataJson.KenoBetTypesSettingInfo);
</script>
