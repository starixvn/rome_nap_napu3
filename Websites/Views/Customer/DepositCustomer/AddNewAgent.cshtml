@helper GenerateBetSettingSportsbook()
    {
        var sports = Sunplus.Accounting.Core.Configurations.SportsSection.Instance.Sports;
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (!sport.Active || sport.Id == "161")
            {
                continue;
            }

            var flat = "";
            flat = sport.Id == "1" ? "soccer='true'" : "remainsport='true'";

            var minBetv = "minbetv" + @sport.Id.ToLower();
            var maxBetv = "maxbetv" + @sport.Id.ToLower();
            var maxPerMatchv = "maxpermatchv" + @sport.Id.ToLower();
    
    <tr>
        <td align="left" style="padding-left: 4px">
            <span>@sport.Name</span>
        </td>
        <td align="left">
            <input id="@minBetv" minbet="true" type="text" @flat style="width: 120px; text-align: right" value="@sport.Minbet" />
            <span></span>
        </td>
        <td align="left">
            <input id="@maxBetv" maxbet="true" type="text" @flat style="width: 120px; text-align: right" value="@sport.Maxbet" />
            <span></span>
        </td>
        <td align="left">
            <input id="@maxPerMatchv" maxpermatch="true" type="text" @flat style="width: 120px; text-align: right" value="@sport.Maxpermatch" />
            <span></span>
        </td>
    </tr>
        }
}
@helper GenerateBetSettingComPtRacing()
    {
        var racings = Sunplus.Accounting.Core.Configurations.RacingSection.Instance.Racings;
        foreach (Sunplus.Accounting.Core.Configurations.RacingElement racing in racings)
        {
            if (!racing.Active)
            {
                continue;
            }
            var isFirst = true;
            var activeCounter = 0;
            foreach (Sunplus.Accounting.Core.Configurations.ToteElement tote in racing.Totes)
            {
                if (tote.Active)
                {
                    activeCounter++;
                }
            }
            foreach (Sunplus.Accounting.Core.Configurations.ToteElement tote in racing.Totes)
            {
                var flat = "";
                if (racing.Id == "151" && tote.Id == "41")
                {
                    flat = "copyfrom";
                }
                else
                {
                    flat = "copyto";
                }

                var minBetId = "v" + racing.Id.ToLower() + "minbet_" + tote.Id;
                var maxBetId = "v" + racing.Id.ToLower() + "maxbet_" + tote.Id;
                var maxpermatchId = "v" + racing.Id.ToLower() + "maxpermatch_" + tote.Id;
                var commId = "v" + racing.Id.ToLower() + "discount_" + tote.Id;
                var winplaceId = "v" + racing.Id.ToLower() + (ViewData["roleId"].ToString() == "3" ? "s" : (ViewData["roleId"].ToString() == "2" ? "m" : "a")) + "positiontaking_" + tote.Id;
                var disableId = "disable" + racing.Id.ToLower() + "_" + tote.Id;
    <tr>
        @if (isFirst && activeCounter != 0)
        {
            isFirst = false;
            <td rowspan="@activeCounter" align="left" style="padding-left: 4px">
                <span>@racing.Name</span>
            </td>
        }
        @if (!tote.Active)
        {
            continue;
        }
        <td align="left" style="padding-left: 4px">
            <span>@tote.Name</span>
        </td>
        <td align="left" style="padding-right: 4px">
            <input id="@minBetId" @flat type="text" minbet="true" style="width: 80px; text-align: right" value="@tote.Minbet" />
            <span></span>
        </td>
        <td align="left" style="padding-right: 4px">
            <input id="@maxBetId" @flat type="text" maxbet="true" style="width: 80px; text-align: right" value="@tote.Maxbet" />
            <span></span>
        </td>
        <td align="left" style="padding-right: 4px">
            <input id="@maxpermatchId" @flat type="text" maxpermatch="true" style="width: 80px; text-align: right" value="@tote.Maxpermatch" />
            <span></span>
        </td>
        <td align="center">
            <select id="@commId" @flat comm="true" style="width: 60px; text-align:left">
            </select>
        </td>
        <td align="center">
            <select id="@winplaceId" @flat winplacept="true" style="width: 60px; text-align:left">
            </select>
        </td>
        <td align="center">
            <input id="@disableId" @flat type="checkbox" /><span>Enable</span>
        </td>
    </tr>
            }
        }
}
@{
    var sports = Sunplus.Accounting.Core.Configurations.SportsSection.Instance.Sports;
}
<script type="text/javascript">
    var arrNumberGameBettypes = [];
    @{
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (sport.Id.Trim() == "161")
            {
                if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
                {
                    if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                    {
                        var bettypes = sport.Bettype.Split(new char[] { ',' });
                        foreach (var bettype in bettypes)
                        {
                           @:window.arrNumberGameBettypes.push(@bettype);
                        }
                    }
                }
                break;
            }
        }
    }
</script>
<script type="text/javascript">
    var sports = [];
    (function () {
    @{
        @:var sport;
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (!sport.Active || sport.Id == "161")
            {
                continue;
            }
            @:sport = {Id: '@sport.Id.ToLower()', Bettype: []};
            if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
            {
                if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                {
                    var bettypes = sport.Bettype.Split(new char[] { ',' });
                    foreach (var bettype in bettypes)
                    {
                       @:sport.Bettype.push(@bettype);
                    }
                }
            }
            @:window.sports.push(sport);
        }
    }
    })();
</script>
<script type="text/javascript">
var arrRacing = [];
(function () {
    var racing;
    var tote;
@{
    var racings = Sunplus.Accounting.Core.Configurations.RacingSection.Instance.Racings;
    foreach (Sunplus.Accounting.Core.Configurations.RacingElement racing in racings)
    {
        if (!racing.Active)
        {
            continue;
        }
        @:racing = { Id: "" , totes: [] };
        @:racing.Id = @racing.Id;
        foreach (Sunplus.Accounting.Core.Configurations.ToteElement tote in racing.Totes)
        {
            if (!tote.Active)
            {
                continue;
            }
            @:tote = {Id: @tote.Id};
            if (tote.BetType == null || tote.BetType == "NA" || tote.BetType == string.Empty || string.IsNullOrWhiteSpace(tote.BetType.Trim()))
            {
                @:tote.Bettype = [];
            }
            else
            {
                var _bettypes = tote.BetType.Split(new char[] { ',' });
                @:tote.Bettype = [];
                foreach (var bettype in _bettypes)
                {
                   @:tote.Bettype.push(@bettype);
                }
            }
            @:racing.totes.push(tote);
        }
        @:window.arrRacing.push(racing);
    }
}
})();
</script>
<script type="text/javascript">
    var dataJsonStr = '@Model.DataJson';
    dataJsonStr = dataJsonStr.replace(/&quot;&quot;/g, '"');
    var dataJson = jQuery.parseJSON(dataJsonStr);
