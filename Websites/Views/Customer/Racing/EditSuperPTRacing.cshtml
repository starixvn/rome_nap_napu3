@using Fanex.PTRacing
@using Fanex.Tarus.Infrastructure.Common;
<link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
<link rel="Stylesheet" href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Core.css")" />
<link rel="Stylesheet" href="@Url.Content("~/Views/Customer/Racing/style/PTRacingStylesheet.css")" />
<div class="maincontent">
    <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
        <tr>
            <td class="maincontent_headerL">
            </td>
            <td class="maincontent_headerC fixfont">
                Update Racing Setting
            </td>
            <td class="maincontent_headerR">
            </td>
        </tr>
    </table>
    <div id="divShowInfo" class="maincontent_box" style="width: 1013px;">
        <div id="err" class="errMsg">
        </div>
        <div id="errMsg" class="error-message">
        </div>
    </div>
    <div class="bg_table" style="width: 1013px;">
        @if (!AppSession.CurrentSystemNAME.Equals(Enumerations.AccountingSystem.EXTERNAL))
        { 
           <table cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td class="custBtn1">
                    </td>
                    <td onclick="return customerPTRacingSetting.updateCustomerSettings();" class="custBtn2 hand">
                        Update
                    </td>
                </tr>
            </tbody>
        </table>
        }
@*customr info*@
        <div id="divCustInfo">
        </div>
        @*betting - comm and position taking*@
        @Html.Partial("~/Views/Customer/Racing/BettingCommSettingAndPositionTakingPartialView.cshtml")
        @*button add*@
        @if (!AppSession.CurrentSystemNAME.Equals(Enumerations.AccountingSystem.EXTERNAL))
        { 
            <table cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td class="custBtn1">
                    </td>
                    <td onclick="return customerPTRacingSetting.updateCustomerSettings();" class="custBtn2 hand">
                        Update
                    </td>
                </tr>
            </tbody>
        </table>
        }
    </div>
</div>
@*PT Engine Script*@
<script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery-1.7.js")"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Languages.en.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Core.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BetTypeGroup.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BetType.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BettingCommSetting.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/PT/CommonPT.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/jQuery/json2.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/ToolTip/wz_tooltip/wz_tooltip.js")"></script>
<script src="~/js/jQuery/knockout/knockout-2.0.0.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/js/BlockUI.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Views/Customer/Racing/Js/PTRacingCommon.js?ver=1")"></script>
<script type="text/javascript" src="@Url.Content("~/Views/Customer/Racing/Js/EditSuperPTRacing.js?ver=1")"></script>
<script type="text/javascript">
    var superId = @Request["custId"]; 
</script>
