@using DNAide.Core;
@using Fanex.Tarus.Customer.Controller.Setting;
@using Sunplus.Accounting.Core.Common;
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/LeftPanel/left_panel.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/monthPicker/monPickr-0.0.1.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css?ver=2" />
<link rel="stylesheet" type="text/css" href="~/Views/Customer/CustomerSetting/SMATurnover/Style/SMATurnover.css" />
<script src="~/js/jQuery/jquery-1.7.js" type="text/javascript"></script>
<script src="~/js/jQuery/json2.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
<script src="~/js/BlockUI.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
<script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
<script src="~/js/jQuery/monthPicker/monPickr-0.0.1.js?ver=1" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1" type="text/javascript"></script>
<script src="~/js/jQuery/Number/jquery.formattyping.js" type="text/javascript"></script>
<div class="main">
    <div class="maincontent">
        <div style="border: 1px solid #7C98A4; width: 800px; padding: 0px" class="maincontent_box">
            <div class="box_header" style="width: 100%; margin: 0px">
                <div id="SMATab" class="left_tab" style="width: 100%">
                    <ul>
                        <li id="ListSMATab" class="current"><a href="javascript:;"><span>SMA Turnover List</span></a></li>
                        <li id="AddSMATab" style="position: relative"><a href="javascript:;"><span style="padding-right: 22px">
                            Add SMA Turnover</span></a></li>
                    </ul>
                </div>
            </div>
            <div style="padding-bottom: 10px; margin-left: 10px; margin-right: 15px;">
                <div id="ListSMAContent" class="marginTurnover">
                    <div class="maincontent_box filterBox">
                        <div id="msgError" class="errMsg" style="display: none">
                        </div>
                        <table>
                            <tr>
                                <td style="width: 80px; text-align: right; padding-left: 8px">
                                    <b>From Date</b>
                                </td>
                                <td>
                                    <input type="text" id="txtfromdate" class="txtdate" style="width: 100px;" />
                                </td>
                                <td style="width: 50px; text-align: right; padding-left: 20px">
                                    <b>To Date</b>
                                </td>
                                <td>
                                    <input type="text" id="txttodate" readonly="readonly" class="txtdate" style="width: 100px;"
                                        onkeyup="SMATurnover.ChangeSport()" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left: 8px; text-align: right">
                                    <div>
                                        <b>Sport</b></div>
                                </td>
                                <td>
                                    <select id="ddlSport" style="width: 105px" onchange="SMATurnover.ChangeSport()">
                                    </select>
                                </td>
                                <td>
                                    <div style="padding-left: 20px; text-align: right">
                                        <b>League</b></div>
                                </td>
                                <td>
                                    <select id="ddlLeague" style="width: 300px">
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div style="padding-left: 8px; text-align: right">
                                        <b>% Used >=</b></div>
                                </td>
                                <td>
                                    <input type="text" id="textbox-percentageused" value="40" style="width: 101px" maxlength="10" onpaste="return false;"/>
                                </td>
                                <td colspan="2" style="padding-left: 30px">
                                    <input type="button" id="btnSubmit" value="Submit" class="btn" onclick="SMATurnover.GetSMATurnoverList()" />
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="contentBox">
                        <div class="_100ReachedBox hidden">
                            <table cellspacing="0">
                                <tr style="line-height: 17px;">
                                    <th class="lbl100Reached">
                                        Number of SMA reached to 100%
                                    </th>
                                    <th class="lbl100ReachedCounter">
                                    </th>
                                </tr>
                            </table>
                        </div>
                        <div class="refreshBox hidden">
                            <div class="refreshIcon" title="Refresh">
                                Not Refresh
                            </div>
                            <div class="refreshDropdownIcon">
                            </div>
                        </div>
                        <div class="countDownOptionContainer">
                            <div class="countDownOption countDownOptionCheck" val="Not Refresh">
                                Not Refresh</div>
                            <div class="countDownOption" val="30">
                                30 sec</div>
                            <div class="countDownOption" val="60">
                                60 sec</div>
                            <div class="countDownOption" val="90">
                                90 sec</div>
                            <div class="countDownOption" val="120">
                                120 sec</div>
                        </div>
                        @Html.Partial("~/Views/Customer/CustomerSetting/SMATurnover/SMATurnoverContent.cshtml")
                    </div>
                </div>
                <div id="AddSMAContent" class="marginTurnover" style="display: none">
                    @Html.Partial("~/Views/Customer/CustomerSetting/SMATurnover/AddSMAContent.cshtml")
                </div>
            </div>
        </div>
    </div>
    <iframe id="downloadFrm" width="0" height="0" frameborder="0" style="display: none">
    </iframe>
</div>
@{
    if (Request["IsExport"] != null &&
        CastAide.AsBoolean(Request["IsExport"]))
    {
        new SMATurnoverController().DownloadTemplate_AddSMAList();
    }
}
<script type="text/javascript" src="~/js/jQuery/AjaxForm/ajax-form.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
<script type="text/javascript" src="~/Views/Customer/CustomerSetting/SMATurnover/Scripts/SMATurnover.js"></script>
<script type="text/javascript" src="~/Views/Customer/CustomerSetting/SMATurnover/Scripts/Helper.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
<script language="javascript" type="text/javascript">
    var currDay = '@DNAide.Core.CastAide.AsDateTime(DateTime.Now.ToShortDateString())';
    var accId = '@AppSession.AccId';
    var balanceUpDay = '@Fanex.Tarus.Customer.DataAccess.SettingCustomer.SMATurnover.SMATurnoverAccess.BalanceUpDay()';
    $(document).ready(function () { SMATurnover.InitPage(); }); 
</script>
