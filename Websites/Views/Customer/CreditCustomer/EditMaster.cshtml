@using Fanex.PTEngine
@using Fanex.Tarus.Customer.CreditCustomer.Entities;
@model Fanex.Tarus.Customer.CreditCustomer.Entities.CustomerSettingView
@{
    Page.Title = "Title goes here";
    //Layout = "Your Layout Page goes here";
}
<link rel="Stylesheet" href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" />
<link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
<link rel="Stylesheet" href="@Url.Content("~/Views/Customer/CreditCustomer/Styles/CustomerSettingCommon.css")" />
@*PT Engine Script*@
<script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery-1.7.js")"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/PT/CommonPT.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/jQuery/json2.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/ToolTip/wz_tooltip/wz_tooltip.js")"></script>
<script src="~/js/jQuery/knockout/knockout-2.0.0.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/js/BlockUI.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Views/Customer/CreditCustomer/Js/CommonCustomerSetting.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Views/Customer/CreditCustomer/Js/EditMaster.js")?@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
@*Custom Script*@
<script type="text/javascript">
    var superId = @Model.UplineCustId;
    var masterId = @Model.CustId;
    var superUserName = "@Model.CustUserName";
    var lblChooseDaily = "Please choose Daily instead of 7 days.";
    var lblChooseOneDay = "Please select at least one day.";
</script>
@*header*@
<div class="maincontent">
    <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
        <tr>
            <td class="maincontent_headerL">
            </td>
            <td class="maincontent_headerC fixfont">
                Edit Master
            </td>
            <td class="maincontent_headerR">
            </td>
        </tr>
    </table>
    <div id="divShowInfo" class="maincontent_box" style="width: 850px;">
        <div id="err" class="errMsg">
        </div>
        <div id="errMsg" class="error-message">
        </div>
    </div>
    <div class="bg_table" style="width: 844px;">
        <table cellspacing="0" cellpadding="0" border="0" style="margin-bottom:10px;">
            <tbody>
                <tr>
                    <td class="custBtn1">
                    </td>
                    <td onclick="return edm.editMaster();" class="custBtn2 hand">
                        Update
                    </td>
                </tr>
            </tbody>
        </table>
        @*Cust Infor Section*@
        @Html.Partial("~/Views/Customer/CreditCustomer/CustInfoPartialView.cshtml", Model)
        @*betting limit and position taking*@
        @Html.Partial("~/Views/Customer/CreditCustomer/BettingLimitAndPositionTakingPartialView.cshtml")
        @*submit button section*@
        <table cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td class="custBtn1">
                    </td>
                    <td onclick="return edm.editMaster();" class="custBtn2 hand">
                        Update
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>