@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using Sunplus.Bingo.Core
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@using Fanex.CustomerSetting.Module.KenoStatus.Configurations

@{
    var p2pSetting = PokerSection.Instance[PokerSection.PokerCollections.CustomerSetting]["visibleP2PSetting"];
    bool visibleP2PSetting = CastAide.AsBoolean(p2pSetting.Value);
    var IsVisibleMaxExposure = Functions.Customer.IsVisibleMaxExposure;
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;
    var enableNumberGame = BingoSettings.NumberGame.Enabled;
    
    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;
    var disabledHR = WebSettings.disabledHR;
    var disabledFI = WebSettings.disabledFI;
    var enableBingo = BingoSettings.BingoGame.Enabled;
    var EnableLiveCasino = WebSettings.EnableLiveCasino;
    var EnableVirtualSports = WebSettings.EnableVirtualSports;
    var disableCasino = WebSettings.disableCS;
    bool allowCS = false;
    bool allowFI = Permissions.IsAllowEditFI();
    bool allowLiveCS = false;
    int IsShowCustomerSettingRenovation = 0;
    bool directMaster = (Model.ParentId == 0 ? true : false);
    if (Model.ParentId == 0)
    {
        allowCS = true;
        allowLiveCS = true;
    }
    else
    {
        var thirdPartyStatus = Permissions.SelStatus3rdParty(CastAide.AsInt32(Model.ParentId));
        allowCS = Model.ParentId == 0 ? true : thirdPartyStatus.CasinoSync;
        allowLiveCS = Permissions.IsAllowEditLiveCasino(Model.ParentId, thirdPartyStatus.LiveCasinoSync);
    }
    if (IsPost)
    {
        IsShowCustomerSettingRenovation = WebSettings.IsShowCustomerSettingRenovation;
    }
    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleMaxExposure)
    {
        colspan++;
    }
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }
    if (enableNumberGame)
    {
        colspanCom++;
    }
    Hashtable hash = new Hashtable();
    hash.Add("p2pSetting", p2pSetting);
    hash.Add("visibleP2PSetting", visibleP2PSetting);
    hash.Add("IsVisibleMaxExposure", IsVisibleMaxExposure);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    hash.Add("enableNumberGame", enableNumberGame);
    hash.Add("disabledHR", disabledHR);
    hash.Add("enableBingo", enableBingo);
    hash.Add("disableCasino", disableCasino);
    hash.Add("EnableLiveCasino", EnableLiveCasino);
    hash.Add("EnableVirtualSports", EnableVirtualSports);
    hash.Add("disabledFI", disabledFI);
    hash.Add("directMaster", directMaster);
    hash.Add("allowCS", allowCS);
    hash.Add("allowLiveCS", allowLiveCS);
    hash.Add("allowKeno", KenoSection.Instance.ShowSetting);
    
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var superItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(superItem, hash);
            result[1] += renderContent(superItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList superItem)
    {
        var bg = (superItem.No % 2 == 0) ? "even" : "";
        var status = superItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = "closed";
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}

@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList superItem, Hashtable hash)
    {
        var bg = rowCSS(superItem);
        var idAllow = superItem.ChildID.ToString() + '_' + superItem.UserName;
    <tr name="tr_@superItem.ChildID" class="@bg">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @superItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                <a onclick="EditSportsBookSetting(4, '@superItem.ChildID', 0 , '@superItem.UserName');"  >@superItem.Status</a>
                <span onclick="EditSportsBookSetting(4, '@superItem.ChildID', 0 , '@superItem.UserName');"   class="status-button" >
                    &nbsp;&nbsp;&nbsp</span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 30px; height: 18px;">
                <span title="Edit" onmouseout="CustomerList.HideEditBox()"  onclick="CustomerList.ShowMenuEdit('div_@superItem.ChildID')" class="edit-button" >
                </span>
                <ul id="div_@superItem.ChildID" style="display:none;">
                    <!--minmaxPT-->
                    <li class="canchange" onclick="EditMinMaxPT(4, '@superItem.ChildID', 0 , '@superItem.UserName');"  >
                        Max PT</li>
                    <!--/minmaxPT-->
                    <li class="canchange" onclick="OpenEditCustInfo('@superItem.ChildID','@Model.ParentId','Super');" >Info</li>
                    <!--horseracing-edit-->
                    @if (!CastAide.AsBoolean(hash["disabledHR"]))
                    {
                        <li class="canchange" onclick="EditHorseracingSetting(4,'@superItem.ChildID')" >Racing</li>
                    }
                    <!--/horseracing-edit-->
                    <!--casino-edit-->
                    @if (!CastAide.AsBoolean(hash["disableCasino"]))
                    {
                        <li class="canchange" onclick="OpenEditCS('@superItem.ChildID');" >Casino</li>
                    }
                    <!--/casino-edit-->
                    <!--finance-edit-->
                    @if (!CastAide.AsBoolean(hash["disabledFI"]))
                    {
                        <li class="canchange" onclick="OpenEditFI('@superItem.ChildID', '@Model.ParentId', '4')" >
                            Finance</li>
                    }
                    <!--/finance-edit-->
                    <!--bingo-edit-->
                    @if (CastAide.AsBoolean(hash["enableBingo"]))
                    {
                        <li class="canchange" onclick="OpenEditBI('@superItem.ChildID', '@Model.ParentId', '4')" >
                            Bingo</li>
                    }
                    <!--/bingo-edit-->
                    <!--noneSuper-->
                    <li class="canchange" onclick="OpenEditTransferTime('@superItem.ChildID',0);">Transfer
                        Condition</li>
                    <!--/noneSuper-->
                    <li class="canchange" onclick="OpenChangePwd('@superItem.ChildID','@superItem.UserName');">
                        Password</li>
                    <!--edit-p2p-->
                    @if (CastAide.AsBoolean(hash["visibleP2PSetting"]))
                    {
                        <li class="canchange" onclick="SuperList.editSetting('@superItem.ChildID', '4');">Poker</li>
                    }
                    <!--/edit-p2p-->
                    <!--edit-liveCasino-->
                    @if (!(!CastAide.AsBoolean(hash["EnableLiveCasino"]) | !CastAide.AsBoolean(hash["allowLiveCS"])))
                    {
                        <li class="canchange" onclick="SuperList.liveCasinoSetting('@superItem.ChildID', '0', '@Model.ParentId');">
                            Live Casino</li>
                    }
                    <!--/edit-liveCasino-->
                    <!--edit-virtualSports-->
                    @if (CastAide.AsBoolean(hash["EnableVirtualSports"]))
                    {
                        <li class="canchange" onclick="SuperList.virtualSportsSetting('@superItem.ChildID', '@Model.ParentId', '4');">
                            Virtual Sports</li>
                    }
                    <!--/edit-virtualSports-->
                      @if (CastAide.AsBoolean(hash["allowKeno"]))
                      {
                        <li class="canchange" onclick="SuperList.kenoSetting('@superItem.ChildID');">
                            Keno</li>
                      }
                       @if (superItem.IsLicensee)
                      {
                       <li class="canchange" onclick="SuperList.asianGamingCasino('@superItem.ChildID');">
                            AG Casino</li>
                      }
                </ul>
            </div>
        </td>
        <td>
            @if (superItem.isDoubleComm)
            {
                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span id="allow_@superItem.ChildID" class="allow-button" onclick="SuperList.confirmUpdateDComm(false,'@idAllow',false);" onmouseout="" onmouseover="">
                    </span>
                </div>
            }
            else
            {
                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span id="disallow_@superItem.ChildID" class="disallow-button"  onclick="SuperList.confirmUpdateDComm(false,'@idAllow',true);" onmouseout="" onmouseover="">
                    </span>
                </div>
            }
            <div class="table-cell c" style="width: 20px; height: 18px;">
                <input id="chk_@idAllow" onclick="CustomerList.selectID()" type="checkbox"/></div>
        </td>
        <td>
            <div id="tooltip_@superItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@superItem.UserName</span>
            </div>
        </td>
    </tr>
}
