@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using Sunplus.Bingo.Core
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@using Fanex.CustomerSetting.Module.KenoStatus.Configurations

@{
    var p2pSetting = PokerSection.Instance[PokerSection.PokerCollections.CustomerSetting]["visibleP2PSetting"];
    bool visibleP2PSetting = CastAide.AsBoolean(p2pSetting.Value);
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;
    var enableNumberGame = BingoSettings.NumberGame.Enabled;

    var disabledHR = WebSettings.disabledHR;
    var disabledFI = WebSettings.disabledFI;
    var enableBingo = BingoSettings.BingoGame.Enabled;
    var EnableLiveCasino = WebSettings.EnableLiveCasino;
    var EnableVirtualSports = WebSettings.EnableVirtualSports;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;
    bool allowFI = Permissions.IsAllowEditFI();
    int IsShowCustomerSettingRenovation = 0;
    var thirdPartyStatus = Permissions.SelStatus3rdParty(CastAide.AsInt32(Model.ParentId));
    bool allowCS = Model.ParentId == 0 ? true : thirdPartyStatus.CasinoSync;
    bool allowLiveCS = Permissions.IsAllowEditLiveCasino(Model.ParentId, thirdPartyStatus.LiveCasinoSync);
    if (IsPost)
    {
        IsShowCustomerSettingRenovation = WebSettings.IsShowCustomerSettingRenovation;
    }

    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }
    if (enableNumberGame)
    {
        colspanCom++;
    }
    Hashtable hash = new Hashtable();
    hash.Add("p2pSetting", p2pSetting);
    hash.Add("visibleP2PSetting", visibleP2PSetting);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    hash.Add("enableNumberGame", enableNumberGame);
    hash.Add("disabledHR", disabledHR);
    hash.Add("enableBingo", enableBingo);
    hash.Add("EnableLiveCasino", EnableLiveCasino);
    hash.Add("EnableVirtualSports", EnableVirtualSports);
    hash.Add("disabledFI", disabledFI);
    hash.Add("allowCS", allowCS);
    hash.Add("allowLiveCS", allowLiveCS);
    hash.Add("allowKeno", KenoSection.Instance.ShowSetting);
    
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var memberItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(memberItem, hash);
            result[1] += renderContent(memberItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem)
    {
        var bg = (memberItem.No % 2 == 0) ? "even" : "";
        var status = memberItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = "closed";
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}

@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem, Hashtable hash)
    {
        var bg = rowCSS(memberItem);
        var idAllow = memberItem.ChildID.ToString() + '_' + memberItem.UserName;
    <tr name="tr_@memberItem.ChildID" class ="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @memberItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                <a onclick="EditSportsBookSetting(1, '@memberItem.ChildID', '@Model.ParentId', '@memberItem.UserName');">@memberItem.Status</a>
                <span onclick="EditSportsBookSetting(1, '@memberItem.ChildID', '@Model.ParentId', '@memberItem.UserName');"  class="status-button" >
                    &nbsp;&nbsp;&nbsp</span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 30px; height: 18px;">
                <span title="Edit" onmouseout="CustomerList.HideEditBox()"  onclick="CustomerList.ShowMenuEdit('div_@memberItem.ChildID')" class="edit-button" >
                </span>
                <ul id="div_@memberItem.ChildID" style="display:none;">
                    <!--horseracing-edit-->
                    @if (!CastAide.AsBoolean(hash["disabledHR"]))
                    {
                        <li class="canchange" onclick="EditHorseracingSetting(1, '@memberItem.ChildID','@Model.ParentId')" >Racing</li>
                    }
                    <!--/horseracing-edit-->
                    <!--casino-edit-->
                    @{
                        var IsOnclickCS = !string.IsNullOrEmpty(ViewBag.synccasinoUpline) ?
                            CastAide.AsBoolean(ViewBag.synccasinoUpline) : CastAide.AsBoolean(hash["allowCS"]);
                        var onclickCS = (IsOnclickCS == true ? "OpenEditCS('" + memberItem.ChildID + "');" : "");
                    }
                    <li class="canchange" onclick="@onclickCS" >Casino</li>
                    <!--/casino-edit-->
                    <!--finance-edit-->
                    @if (!CastAide.AsBoolean(hash["disabledFI"]))
                    {
                        <li class="canchange" onclick="OpenEditFI('@memberItem.ChildID', '@Model.ParentId', '1')" >
                            Finance</li>
                    }
                    <!--/finance-edit-->
                    <!--bingo-edit-->
                    @if (CastAide.AsBoolean(hash["enableBingo"]))
                    {
                        <li class="canchange" onclick="OpenEditBI('@memberItem.ChildID', '@Model.ParentId', '1')" >
                            Bingo</li>
                    }
                    <!--/bingo-edit-->
                    <li class="canchange" onclick="OpenChangePwd('@memberItem.ChildID','@memberItem.UserName');">
                        Password</li>
                    <!--edit-p2p-->
                    @if (CastAide.AsBoolean(hash["visibleP2PSetting"]))
                    {
                        <li class="canchange" onclick="MemberList.editSetting('@memberItem.ChildID', '1');">
                            Poker</li>
                    }
                    <!--/edit-p2p-->
                    <!--edit-liveCasino-->
                    @if (!(!CastAide.AsBoolean(hash["EnableLiveCasino"]) | !CastAide.AsBoolean(hash["allowLiveCS"])))
                    {
                        <li class="canchange" onclick="MemberList.liveCasinoSetting('@memberItem.ChildID', '0', '@Model.ParentId');">
                            Live Casino</li>
                    }
                    <!--/edit-liveCasino-->
                    <!--edit-virtualSports-->
                    @if (CastAide.AsBoolean(hash["EnableVirtualSports"]))
                    {
                        <li class="canchange" onclick="MemberList.virtualSportsSetting('@memberItem.ChildID', '@Model.ParentId', '1');">
                            Virtual Sports</li>
                    }
                    <!--/edit-virtualSports-->
                     @if (CastAide.AsBoolean(hash["allowKeno"]))
                    {
                        <li class="canchange" onclick="MemberList.kenoSetting('@memberItem.ChildID');">
                            Keno</li>
                    }
                </ul>
            </div>
        </td>
        <td>
            @if (!Model.ParentDoubleComm && Model.ParentId != 0)
            {
                <div class="table-cell" style="width: 45px; height: 18px;">
                    <span class="off-button"></span>
                </div>
                <div class="table-cell c" style="width: 10px; height: 18px;">
                    <input type="checkbox" disabled="disabled" /></div>
            }
            else
            {
                if (memberItem.isDoubleComm)
                {
                <div class="table-cell" style="width: 45px; height: 18px;">
                    <span id="allow_@memberItem.ChildID" class="on-button" onclick="MemberList.confirmUpdateSingle(false,'@idAllow',false);" onmouseout="" onmouseover="">
                    </span>
                </div>
                }
                else
                {
                <div class="table-cell" style="width: 45px; height: 18px;">
                    <span id="disallow_@memberItem.ChildID" class="off-button"  onclick="MemberList.confirmUpdateSingle(false,'@idAllow',true);" onmouseout="" onmouseover="">
                    </span>
                </div>
                }
                <div class="table-cell c" style="width: 10px; height: 18px;">
                    <input id="chk_@idAllow" onclick="CustomerList.selectID()" type="checkbox"/></div>
            }
        </td>
        <td>
            <div  id="tooltip_@memberItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@memberItem.UserName</span>
            </div>
        </td>
    </tr>
}
