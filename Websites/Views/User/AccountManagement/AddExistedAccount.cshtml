<table border="0" cellpadding="2" cellspacing="0" style="border-collapse: collapse;
    margin-top: 4px; margin-left: 4px">
    <tr>
        <td align="left" style="font-weight: bold; width: 300px; border: 1px solid #7C98A4;
            background-color: #B5C4D0 !important">
            Add Existed Account
        </td>
    </tr>
    <tr>
        <td style="border: 1px solid #7C98A4;">
            <span style="margin-left: 4px">Username:</span><input id="tbxUsernameExisted" type="text"
                style="margin-left: 12px" />
        </td>
    </tr>
    <tr>
        <td style="border: 1px solid #7C98A4">
            <span style="margin-left: 4px">Department:</span><select id="selDeptExistedAcc" style="margin-left: 4px"></select>
        </td>
    </tr>
    <tr>
        <td style="border: 1px solid #7C98A4">
            <input type="button" class="btn" value="Add" onclick="javascript:accManager.accounts.addExistedAcc();" />
        </td>
    </tr>
</table>
