@model Fanex.Tarus.User.Entities.AccManagementViewData
<link href="~/LiveCasino/Report/Style/Common.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/LeftPanel/left_panel.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
<script src="~/js/jQuery/jquery-latest.js" type="text/javascript"></script>
<script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
<script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
<script src="~/js/jQuery/Pager/jpager.js" type="text/javascript"></script>
<script src="~/js/jQuery/Jlinq/jlinq.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/jQuery/jquery.json-1.3.js" type="text/javascript"></script>
<script src="~/js/json2.js" type="text/javascript"></script>
<script src="~/js/Customer.js" type="text/javascript"></script>
<script src="~/js/Popup/centreIt-1.1.5.js" type="text/javascript"></script>
<script src="~/js/Popup/jquery.popup.js" type="text/javascript"></script>
<script src="~/Views/User/AccountManagement/js/AccManagement.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
<script type="text/javascript">
var viewModel = @Html.Raw(Json.Encode(Model));
</script>
<div id="err">
</div>
<div class="main">
    <div class="maincontent">

        <div id="divMainHeader" style="height:63px; background-color:#fff; position:fixed; width:100%; margin-top:-4px; padding-top:10px;">

            <div class="box_header" style="width: 100%;">
                <div id="left_tab1" class="left_tab" style="width: 100%">
                    <ul>
                        <li id="left_tab1_1" class="current"><a href="javascript:;"><span>View All Departments</span></a></li>
                        <li id="left_tab1_2" style="position: relative"><a href="javascript:;"><span>Add Department</span>
                        </a></li>
                        <li id="left_tab1_3" style="position: relative"><a href="javascript:;"><span>Add Account</span></a></li>
                        <li id="left_tab1_4" style="position: relative"><a href="javascript:;"><span>Add Existed
                            Account</span></a></li>
                        <li id="left_tab1_5" style="position: relative"><a href="javascript:;"><span>View All
                            Accounts</span></a></li>
                        <li id="left_tab1_6" style="position: relative"><a href="javascript:;"><span>User Control
                            Log</span></a></li>
                    </ul>
                </div>
            </div>

            @Html.Partial("~/Views/User/AccountManagement/DeptFilter.cshtml")

            @Html.Partial("~/Views/User/AccountManagement/AccFilter.cshtml")

        </div>


        <div id="left_tab1_1_content" style="margin-top:70px; margin-bottom:2px">
            @Html.Partial("~/Views/User/AccountManagement/Department.cshtml")
        </div>
        <div id="left_tab1_2_content" style="display: none;margin-top:40px">
            @Html.Partial("~/Views/User/AccountManagement/AddDept.cshtml")
        </div>
        <div id="left_tab1_3_content" style="display: none;margin-top:40px">
            @Html.Partial("~/Views/User/AccountManagement/AddAccount.cshtml")
        </div>
        <div id="left_tab1_4_content" style="display: none;margin-top:40px">
            @Html.Partial("~/Views/User/AccountManagement/AddExistedAccount.cshtml")
        </div>
        <div id="left_tab1_5_content" style="display: none;margin-top:70px">
            @Html.Partial("~/Views/User/AccountManagement/Account.cshtml")
        </div>
        <div id="left_tab1_6_content" style="display: none;margin-top:40px">
            @Html.Partial("~/Views/User/UserControlLog/Index.cshtml")
        </div>

    </div>
</div>
