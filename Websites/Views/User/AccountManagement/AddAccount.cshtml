<table border="0" cellpadding="2" cellspacing="0" style="border-collapse: collapse;
    margin-top: 4px; margin-left: 4px">
    <tbody>
        <tr>
            <td align="left" style="font-weight: bold; width: 450px; border: 1px solid #7C98A4;
                background-color: #B5C4D0 !important">
                Add New Account
            </td>
        </tr>
        <tr>
            <td style="border: 1px solid #7C98A4">
                <span style="margin-left: 4px">User Name:</span><input id="tbxUserNameNewAcc" type="text"
                    style="margin-left: 9px" />
                <span style="margin-left: 20px">Password:</span><input id="tbxPassNewAcc" type="password"
                    style="margin-left: 13px; width:120px" />
            </td>
        </tr>
        <tr>
            <td style="border: 1px solid #7C98A4">
                <span style="margin-left: 4px">First Name:</span><input id="tbxFirstNameNewAcc" type="text"
                    style="margin-left: 10px" />
                <span style="margin-left: 20px">Last Name:</span><input id="tbxLastNameNewAcc" type="text"
                    style="margin-left: 7px; width:120px" />
            </td>
        </tr>
        <tr>
            <td style="border: 1px solid #7C98A4">
                <span style="margin-left: 4px">Department:</span><select id="selDeptNewAcc" style="margin-left: 4px"></select>
            </td>
        </tr>
        <tr>
            <td style="border: 1px solid #7C98A4">
                <input type="button" class="btn" value="Add" onclick="javascript:accManager.accounts.addAcc();" />
            </td>
        </tr>
    </tbody>
</table>
