<div id="divUserLogAdminPolicy" class="content-warper" style="display: none; margin-top: 4px">
    <div class="content-header clearfix">
        <div class="header-scroll">
            <table class="tbl-header-scroll">
                <tr>
                    <td rowspan="2" style="border-bottom: none 0px;">
                        <div class="col360 c">
                            Function</div>
                    </td>
                    <td colspan="2">
                        <div class="c">
                            Before</div>
                    </td>
                    <td colspan="2" style="background:#EFE3AF">
                        <div class="c">
                            After</div>
                    </td>
                </tr>
                <tr>
                    <td style="border-bottom: none 0px;">
                        <div class="col100 c">
                            Read</div>
                    </td>
                    <td style="border-bottom: none 0px;">
                        <div class="col100 c">
                            Host</div>
                    </td>
                    <td style="border-bottom: none 0px;background:#EFE3AF">
                        <div class="col100 c">
                            Read</div>
                    </td>
                    <td style="border-bottom: none 0px;background:#EFE3AF">
                        <div class="col100 c">
                            Host</div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="content-body clearfix">
        <div class="body-scroll">
            <table class="tbl-body-scroll">
                <tbody id="tbodyUserLogAdminPolicy">
                </tbody>
            </table>
            <script id="scriptTemplateUserLogAdminPolicy" type="text/html">
                <tr level="${level}" _id="${ID}" parentID="${ParentId}" TotalSub="${TotalSub}" 
                {{if hide == true}}
                    class="hidden"
                {{/if}}
                ><td>
                        <div class="col360 l">
                            <span icon="true" 
                            {{if TotalSub != 0}}
                                class="tree-expanded">
                            {{else}}
                                style="background:url('../App_Themes/Images/TreeViewImg.GIF') no-repeat scroll 0 0 transparent">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            {{/if}}
                            </span>
                            <span funcname="true">${FuncDesc}</span>
                            <input type="hidden" value="${level}" level="true" />
                            <input type="hidden" value="${ID}" funcid="true" />
                            <input type="hidden" value="${TotalSub}" TotalSub="true" />
                        </div>
                    </td><td>
                        <div class="col100 c">
                            <input type="checkbox" cbxRead="true" onclick="this.checked = 
                                {{if IsReadOld}} 
                                    true
                                {{else}}
                                    false
                                {{/if}}
                            ;"
                            {{if IsReadOld}} 
                                checked="checked"
                            {{/if}}
                                />
                        </div>
                    </td><td>
                        <div class="col100 c">
                            <input type="checkbox" cbxHost="true" onclick="this.checked = 
                                {{if IsHostOld}} 
                                    true
                                {{else}}
                                    false
                                {{/if}}
                            ;"
                            {{if IsHostOld}} 
                                checked="checked"
                            {{/if}}
                            />
                        </div>
                    </td><td style="background-color:#FCFAEE">
                        <div class="col100 c">
                            <input type="checkbox" cbxRead="true" onclick="this.checked = 
                                {{if IsReadNew}} 
                                    true
                                {{else}}
                                    false
                                {{/if}}
                            ;"
                            {{if IsReadNew}} 
                                checked="checked"
                            {{/if}}
                                />
                        </div>
                    </td><td style="background-color:#FCFAEE">
                        <div class="col100 c">
                            <input type="checkbox" cbxHost="true" onclick="this.checked = 
                                {{if IsHostNew}} 
                                    true
                                {{else}}
                                    false
                                {{/if}}
                            ;"
                            {{if IsHostNew}} 
                                checked="checked"
                            {{/if}}
                            />
                        </div>
                    </td>
                </tr>
            </script>
            <script id="scriptTmpUserLogAdminPolicy_NoInfo" type="text/html">
                    <tr><td style="width:772px" align="center">
                        <span style="font-weight:bold">There is no information</span>
                    </td>
                    </tr>
                </script>
        </div>
    </div>
</div>
