@using Fanex.Tarus.Infrastructure.Resource;
@using Sunplus.Accounting.Core.Configurations;
@{
    Page.Title = "Title goes here";
}
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
<link rel="stylesheet" type="text/css" href="~/js/MultipleSelect/jquery.multiselect.css" />
<link rel="stylesheet" type="text/css" href="~/Views/Admin/LegendManagement/Styles/LegendManagement.css" />
<div class="main">
    <div id="divMainHeader">
        <div id="left_tab1">
            <ul>
                <li class="lefticon"></li>
                <li class="current"><span>@Labels.LegendManagement</span></li>
            </ul>
        </div>
    </div>
    <div class="maincontent">
        <div class="filterBox">
            <div class="filterContent">
                <table class="table">
                    <tr class="c b">
                        <td>
                            <div class="lbl-field col_4 align-right width-auto b">
                                @Labels.Menu
                            </div>
                        </td>
                        <td>
                            <div class="edit-field col_8">
                                <select id="ddlMenu">
                                </select>
                            </div>
                        </td>
                        <td>
                            <input id="btnLoad" name="btnLoad" type="button" value="Load" class="btn" />
                        </td>
                        <td>
                            <input id="btnClear" name="btnClear" type="button" value="Clear" class="btn" />
                        </td>
                        <td>
                            <input id="btnPreview" name="btnPreview" type="button" value="Preview" class="btn" />
                        </td>
                        <td>
                            <input id="btnSave" name="btnSave" type="button" value="Save" class="btn" />
                        </td>
                    </tr>
                </table>
                <div id="informationMssg" class="hidden b">
                </div>
            </div>
        </div>
        <div class="contentBox">
            <div id="htmlEditor">
            </div>
            <div id="previewMenuLegendDialog" class="hidden">
            </div>
            <div id="uploadImageDialog" class="hidden">
            </div>
            <div id="uploadImageDialogTemplate" class="hidden">
                <ul id="uploadbox-tab">
                    <li><a href="javascript:;" class="tab-item current" rel="tab-url">@Labels.From_URL</a></li>
                    <li><a href="javascript:;" class="tab-item" rel="tab-choose">@Labels.Upload_Image</a></li>
                </ul>
                <div id="tab-url" class="tab-url chooseimg hidden">
                    <div class="b image-location">@Labels.Image_location</div>
                    <input id="txt_url" type="input" value="" />
                </div>
                <div id="tab-choose" class="tab-choose chooseimg hidden">
                    <span class="b">@Labels.Choosing_image</span><br />
                    <input id="txtfile" type="file" name="txtfile" size="40" class="inputfile" /><br />
                    <small>@Labels.LegendManagement_UploadFileNote</small>
                </div>
                <div class="uploadbuttonbar">
                    <input id="btnUpload" class="btn" value="Upload" />
                    <input id="btnCancelUpload" class="btn" value="Cancel" />
                </div>
                <div id="upload_message" class="hidden">
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
<script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">
</script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js" type="text/javascript"></script>
<script src="~/js/tiny_mce/ajax.upload.js" type="text/javascript"></script>
<script src="~/js/tiny_mce/jquery.tinymce.js" type="text/javascript"></script>
<script type="text/javascript" src="~/Views/Admin/LegendManagement/Scripts/LegendManagement.js?version=@WebSettings.Version"></script>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';
</script>
