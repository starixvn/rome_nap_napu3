@using DNAide.Core;
@using Sunplus.Accounting.Core.Configurations;
@using Sunplus.Accounting.Business.Report;
@using Sunplus.Accounting.Business.Report.Common;
@using Fanex.Tarus.Infrastructure.Resource;
@using Fanex.Tarus.Infrastructure.Configurations;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Reports.Title</title>
    <link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Admin/SecurityCode/UpdateMultiUsers/Styles/UpdateMultiUsers.css?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="~/js/common.js"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">    
    </script>
    <script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js" type="text/javascript"></script>
    <script src="~/js/Utils/jquery.stringformat.js" type="text/javascript"></script>
    <script src="~/Views/Admin/SecurityCode/UpdateMultiUsers/Scripts/UpdateMultiUsers.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript">     
    </script>
</head>
<body>
    <div class="main">
        <table class="maincontent" border="0" cellpadding="0px" cellspacing="0px">
            <tr>
                <td>
                    <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                        <tr>
                            <td class="maincontent_headerL">
                            </td>
                            <td class="maincontent_headerC">
                                Security Code
                            </td>
                            <td class="maincontent_headerR">
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="maincontent_box">
                        <table id="useTextboxFilters" cellspacing="1">
                            <tr>
                                <td class="l b labelUserList">
                                    User list
                                </td>
                                <td class="l">
                                    <textarea id="txtUserList" name="txtUserList"></textarea>
                                </td>
                            </tr>
                            <tr>
                                <td class="l b " colspan="2">
                                   User list separated by comma (ex: abc, cde)
                                </td>
                               
                            </tr>
                            <tr>
                                <td>
                                </td>
                                <td>
                                    <input id="btnGetUserList" class="btn" type="button" value="Submit" />
                                </td>
                            </tr>
                        </table>
                        <table id="useExcelFileFilters" cellspacing="1">
                            <tr>
                                <td class="l b labelUserList">
                                    Choose an Excel file
                                </td>
                                <td class="l">
                                    <input type="file" id="fileUpload" />
                                    <input id="btnUploadFile" class="btn" type="submit" value="Validate" disabled="disabled" />
                                </td>
                            </tr>
                            <tr>
                                <td class="l b labelUserList" colspan="2">
                                    <a href="~/Views/Admin/SecurityCode/UpdateMultiUsers/Data/template.xls">Download template</a>
                                </td>
                            </tr>
                        </table>
                        <input id="chbUseExcelFile" type="checkbox" value="Using excel file" />
                        Using excel file
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <div id="errorMessage" class="hidden">
                    </div>
                    <div id="bg_table" class="">
                        @Html.Partial("~/Views/Admin/SecurityCode/UpdateMultiUsers/UserList.cshtml")
                        <table id="updateSecurityCodeFilters" cellspacing="1" class="hidden">
                            <tr>
                                <td>
                                    <span>
                                        <input id="chbUseBaseSecurityCode" type="checkbox" />
                                        <label for="chbUseBaseSecurityCode">
                                            Use base security code</label>
                                    </span>
                                </td>
                                <td>
                                    <input id="txtBaseSecurityCode" class="txt" type="text" maxlength="6" disabled="disabled" />
                                </td>
                                <td>
                                    <div id="baseSecurityCodeValidation" class="hidden">
                                    </div>
                                </td>
                                <td>
                                    <input id="btnCheckSecurityCodes" class="btn hidden" type="submit" value="Check Security Code" />
                                </td>
                                <td>
                                    <input id="btnUpdateUsersSecurityCode" class="btn" type="submit" value="Update" />
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
</script>
</html>
