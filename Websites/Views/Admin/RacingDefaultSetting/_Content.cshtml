@using Fanex.Tarus.Admin.Entities;
@model List<RacingDefaultSetting>
@functions {
    public string MapSport(int SportID)
    {
        string result = string.Empty;
        switch (SportID)
        {
            case 151:
                result = "Horse Racing";
                break;
            case 152:
                result = "Greyhound";
                break;
            case 153:
                result = "Harness";
                break;
        }
        return result;
    }

    public string MapTote(int BettypeID)
    {
        string result = string.Empty;
        switch (BettypeID)
        {
            case 31:
                result = "SA Tote";
                break;
            case 41:
                result = "UK/Irish Tote";
                break;
            case 51:
                result = "Aust Tote";
                break;
        }
        return result;
    }
}
<div id="Rarcing" class="freegrid display-none">
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                     <th>
                            <div class="width30 height34 table-cell">
                                No</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Sport</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Tote</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Currency</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Standard Code</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Min Bet</div>
                        </th>
                        <th>
                            <div class="width45 height34 table-cell">
                                 <input id="btnSaveMultiple" class="btnUpdate"  onclick="racingDefaultSetting.updateMultiple()" value="" disabled="disabled" type="" h="true" title="Save"/></div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div id="tblContentDiv" class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content ">
                <thead>
                    <tr>
                        <th>
                            <div class="width30 height34 table-cell">
                                No</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Sport</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Tote</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Currency</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Standard Code</div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                Min Bet</div>
                        </th>
                        <th>
                            <div class="width45 height34 table-cell">
                                  <input class="btnUpdate" disabled="disabled" type="button" h="true" title="Save"/></div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count > 0)
                {
                    int i = 0;
                   
                    foreach (RacingDefaultSetting racing in Model)
                    {
                        string even = i % 2 == 0 ? string.Empty : "evenrow";
                    <tr class="@even">
                        <td >
                            <div class="width30 height20 c table-cell">
                                @racing.Index</div>
                        </td>
                        <td>
                            <div class="width120 height20 c  table-cell">
                                @MapSport(racing.SportTypeID)</div>
                        </td>
                        <td>
                            <div class="width120 height20 c  table-cell">
                                @MapTote(racing.BettypeID)</div>
                        </td>
                        <td>
                            <div class="width120 height20 c  table-cell">
                                @racing.CurrencyName</div>
                        </td>
                        <td>
                            <div class="width120 height20 c  table-cell">
                                @racing.CurrencyCode</div>
                        </td>
                        <td>
                            <div class="width120 height20 c">
                              <input class="textBox" id="txtCurrency_@racing.Index" onkeyup ="racingDefaultSetting.checkEnableSubmit('@racing.MinBet',@racing.Index)" value="@racing.MinBet" type="text" style="background-color: #fff; width: 90px; text-align: right;"/>
                                </div>
                        </td>
                        <td>
                            <div class="width45 height20 c">
                            <input id="btnSave_@racing.Index" class="btnUpdate" onclick="racingDefaultSetting.updateSingle(@racing.Index)" value="" disabled="disabled" type="" h="true" title="Save"/></div>
                        </td>
                    </tr>
                        i++;
                    }
                }
                else
                {
                     <tr>
                        <td colspan = "7">
                            <div style="width: 705px;" class=" height20 c b">
                               There is no information.</div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    var racingList = '@Json.Encode(Model)';
    racingList = racingList.replace(/&quot;/g, '"');
    var racingListModel = jQuery.parseJSON(racingList);
    var _countSaveQuality = 0;
    $('#err').hide();
</script>
