@model List<Fanex.Tarus.Admin.Entities.Sport>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/Admin/RacingDefaultSetting/Style/RacingDefaultSetting.css" />
</head>
<body>
    <div class="main">
        <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
            <tr>
                <td>
                    <div id="divMainHeader" class="">
                        <div id="left_tab1">
                            <ul>
                                <li class="lefticon"></li>
                                <li class="current"><span>Racing Default Setting</span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="maincontent" style="">
                        <div class="filterBox" style="width: 727px;">
                            <div class="filterContent">
                                <div id="filter" style="border: none !important">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="width: 30px;">
                                                    <font class="b">Sport </font>
                                                </td>
                                                <td style="width: 120px;">
                                                    <select id="selectSport" style="width: 100px; height: 18px;">
                                                    </select>
                                                </td>
                                                <td style="width: 30px;">
                                                    <font class="b">Tote</font>
                                                </td>
                                                <td style="width: 120px;">
                                                    <select id="selectTote" style="width: 100px; height: 18px;">
                                                    </select>
                                                </td>
                                                <td style="width: 30px;">
                                                    <font class="b">Currency</font>
                                                </td>
                                                <td>
                                                 <input id="txtCurrency" value="All" onfocus="if (this.value=='All')this.value='';" onblur="if (this.value=='')this.value='All';"  type="text" style="background-color: #fff; width: 100px;"/>
                                                   @* <input id="txtCurrency" value="All"  type="text" style="background-color: #fff; width: 100px;"/>*@
                                                </td>
                                                <td>
                                                    <div style="margin-left: 5px;">
                                                        <input class="btn" type="button" id="btnReport" value="Submit" onclick="racingDefaultSetting.selRacingDefaultSetting()" />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div id="err" style="display: none">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="racingContent" style="margin-top: 5px;">
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
     <div id="dialogConfirm" style="display: none;">
        <table border="0px" id="tblconfirm">
        </table>
    </div>
    <script type="text/javascript">
        var sportList = '@Json.Encode(Model)';
        sportList = sportList.replace(/&quot;/g, '"');
        var sportListModel = jQuery.parseJSON(sportList);

        $.each(sportListModel, function (i, item) {
        $('#selectSport').append('<option value="'
                                 + item.SportID
                                 + '">'
                                 + item.SportName
                                 + '</option>');
        });

        $.each(sportListModel[0].ToteList, function (i, item) {
            $('#selectTote').append('<option value="'
                                     + item.ToteID
                                     + '">'
                                     + item.ToteName
                                     + '</option>');
        });

    window.rootUrl = '@Url.Content("~")';
 
    head.js("@Url.Content("~/js/jQuery/jquery.js")",
            "@Url.Content("~/js/json2.js")", 
            "@Url.Content("~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1")",
            "@Url.Content("~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js")",
            "@Url.Content("~/js/IBCWnd/IBCWnd.js")", 
            "@Url.Content("~/js/dialogbox.js")",
            "@Url.Content("~/js/common.js")", 
            "@Url.Content("~/Views/Admin/RacingDefaultSetting/js/RacingDefaultSetting.js?ver=34")");
    </script>
</body>
</html>
