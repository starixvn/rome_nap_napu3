@model Fanex.Tarus.Finance.Model.Transfer.CrossTransfer
<link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Public/input.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Public/common.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/LeftPanel/left_panel.css" rel="stylesheet" type="text/css" />
<link href="~/UserGuide/css/userguide.css" rel="stylesheet" type="text/css" />
<script type="text/javascript" src="~/js/jQuery/jquery.js"></script>

<script src="~/js/Utils/jquery.utils.js" type="text/javascript"></script>

<script type="text/javascript" src="~/UserGuide/js/userGuide.js"></script>
<script type="text/javascript" src="~/UserGuide/js/centreIt-1.1.5.js"></script>
<script src="~/js/jQuery/jquery.json-1.3.js" type="text/javascript"></script>
<script type="text/javascript" src="~/js/BlockUI.js"></script>
<script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
<script type="text/javascript" src="~/js/common.js"></script>
<script src="~/js/jQuery/Number/jquery.setcaretposition.js" type="text/javascript"></script>
<script src="~/js/jQuery/Number/jquery.caret.1.02.js" type="text/javascript"></script>
<script src="~/js/jQuery/Number/jquery.formattyping.js" type="text/javascript"></script>
<script src="~/Views/Finance/Transfer/js/CrossTransfer.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
<script type="text/javascript">


    var fromUsername = '@Sunplus.Accounting.Core.Common.AppSession.CustUName';    
    
    function validateValue() {
        $('#errMsg').hide();
        var _toUser = document.getElementById("touser").value;
        if (_toUser.isNullOrEmpty()) {
            $('#errMsg').show();
            showAlertMessage("errMsg", "Invalid To User", 1);
            return false;
        }

        var _exRate = document.getElementById("exrate").value;
        if (!_exRate.isNumeric() || parseFloat(_exRate) == 0) {
            $('#errMsg').show();
            showAlertMessage("errMsg", "Invalid Exchange Rate", 1);
            return false;
        }

        var _amount = document.getElementById('txtamount').value;
        if (!_amount.isNumeric() || parseFloat(_amount) == 0) {
            $('#errMsg').show();
            showAlertMessage("errMsg", "Invalid Amount", 1);
            return false;
        }
        var param = {
            fromCustName: fromUsername,
            toCustName: _toUser,
            exRate: _exRate,
            amount: _amount,
            remark: $("#remark").val()
        };
        
        if (isNaN(parseFloat(_amount))) {
            return false;
        }
        param.amount = parseFloat(_amount);
        transfer.utils.blockUI();
        $.post("TransferYesterdayTransactionHandler", param,
            function (data) {
                if (parseInt(data.ErrorCode) != 0) {
                    transfer.utils.showError(data.ErrorMessage);
                }
                else {
                    
                    $("#frmTransfer").attr("src", '../TransferResult.aspx?fuser=' + escape(fromUsername) + "&touser=" + _toUser + "&exrate=" + _exRate);
                }
                transfer.utils.unBlock();
            });
        return true;
    }

    var showHelpMultiCrossTran = function (functionName) {
        var url = "UserGuide/View.aspx?functionName=" + functionName;
        ShowPopupSettle(url, "Multiple Cross-Currency Finance Transfer", 720, 600, 50, 100);
    };
</script>
<style type="text/css">
    .tblFinance
    {
    }
    .tblFinance tr
    {
        line-height: 12px;
    }
</style>
@{
    var IsHadPermissionOnCrossCurrencyTransfer = Model.IsHadPermissionOnCrossCurrencyTransfer;
    var IsHadPermissionOnYesterdayTransfer = Model.IsHadPermissionOnYesterdayTransfer;
}
<input id="hiddenForexAccount" type="hidden" value="@Model.ForexAccount" />
<div id="errMsg" style="display: none">
</div>
<div class="main">
    <div class="maincontent">
        <div style="border: 1px solid #7C98A4; width: 700px">
            <div class="box_header" style="width: 100%; margin: 0px">
                <div id="left_tab1" class="left_tab" style="width: 100%">
                    <ul>
                        <li id="left_tab1_1" style='float:left;display: 
                            @{ 
                                if (IsHadPermissionOnYesterdayTransfer)
                                { 
                                    @:block
                                }
                                else
                                { 
                                    @:none
                                }
                            }'
                                @{ 
                                    if (IsHadPermissionOnYesterdayTransfer)
                                    {
                                        @:class='current'
                                    }
                                }><a href="javascript:;"><span>Transfer Yesterday's Transactions </span></a>
                        </li>
                        <li id="left_tab1_2" style='float:left;display: 
                            @{ 
                                if (IsHadPermissionOnCrossCurrencyTransfer)
                                {
                                    @:block
                                }
                                else
                                {
                                    @:none 
                                }
                            }; position:relative'
                                @{ 
                                    if (!IsHadPermissionOnYesterdayTransfer)
                                    { 
                                        @:class='current'
                                    }
                                }><a href="javascript:;"><span style="padding-right: 22px">Finance Cross-Currency Transfer</span>
                                </a><span style="background-image: url('../UserGuide/image/icon_help.png'); cursor: pointer;
                                    width: 14px; height: 14px; position: absolute; right: 8px; top: 3px" onclick="javascript:userGuide.show('SingleCrossCurrencyFinanceTransfer', 'Single Cross-Currency Finance Transfer', 700, 600);">
                                </span></li>
                        <li id="left_tab1_3" style='float:left;display: 
                            @{ 
                                if (IsHadPermissionOnCrossCurrencyTransfer)
                                {
                                    @:block
                                }
                                else
                                {
                                    @:none 
                                }
                            }; position:relative'><a href="javascript:;"><span style="padding-right: 22px">Finance Cross-Currency Transfer (New)</span>
                                </a></li>
                    </ul>
                </div>
            </div>
            <div>
                <div id="content_tab1" style="margin-top: 10px; margin-left: 10px; display: 
                        @{ 
                            if (IsHadPermissionOnYesterdayTransfer)
                            { 
                                @:block
                            }
                            else
                            { 
                                @:none
                            }
                        }">
                    @Html.Partial("~/Views/Finance/Transfer/TransferYesterdayTransactions.cshtml")
                </div>
                <div id="content_tab2" style="margin-top: 10px; margin-left: 10px; margin-bottom: 60px;
                        position: relative; display: 
                        @{ 
                            if (IsHadPermissionOnYesterdayTransfer)
                            { 
                                @:none
                            }
                            else
                            {
                                if (IsHadPermissionOnCrossCurrencyTransfer)
                                { 
                                    @:block 
                                }
                                else
                                { 
                                    @:none
                                }
                            }
                        }">
                    @Html.Partial("~/Views/Finance/Transfer/CrossCurrencyTransfer.cshtml")
                </div>
                <div id="content_tab3" style="margin-top: 10px; margin-left: 10px; margin-bottom: 60px;
                        position: relative; display: none">
                    @Html.Partial("~/Views/Finance/Transfer/CrossCurrencyTransferNew.cshtml")
                </div>
            </div>
        </div>
    </div>
</div>
