@using System.Configuration;
@helper GenerateCurrencyCodes(){
    var group = ConfigurationManager.AppSettings["Fanex.Tarus.Finance.CrossBaseCurrency"];
    var listCurrencyCodes = group.Split(',');
    <option value="">[Select]</option>
    foreach(string code in listCurrencyCodes)
    {
        @:<option value="@code">@code</option>
    }
}
<script type="text/javascript">
@{
    var _crossTransferService = new Fanex.Tarus.Finance.Business.Transfer.CrossTransferService();
    var listExchangeRate = _crossTransferService.SelectAllExchangeRate();
    @:var arrExchangeRate = [];
    foreach(var exchangeRate in listExchangeRate)
    {
        @:arrExchangeRate.push({Code: "@exchangeRate.Code", ActualRate : @exchangeRate.ActualRate, Currency : "@exchangeRate.Currency", ExchangeId : @exchangeRate.ExchangeId});
    }
}
</script>
