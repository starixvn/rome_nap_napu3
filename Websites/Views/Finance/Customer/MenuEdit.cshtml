<div id="div_${Id}" style="display: none; position: absolute; z-index: 1000; width:121px">
    <ul class="openedit">
        <li class="canchange" onclick="OpenEditMinMaxPT('${Id}','${Type}');">Min Max PT</li>
        <li class="canchange" onclick="OpenEditCustInfo('${Id}','${Type}');">Info</li>
        {{if !DisabledHR}}
        <li class="canchange" onclick="OpenEditHR('${Id}',${RoleId})">Racing</li>
        {{/if}} {{if !DisableCS}}
        <li class="canchange" onclick="OpenEditCS('${Id}');">Casino</li>
        {{/if}} {{if !DisabledFI}}
        <li class="canchange" onclick="OpenEditFI('${Id}', '${ParentId}', '${RoleId}')">Finance</li>
        {{/if}} {{if BingoGameEnabled}}
        <li class="canchange" onclick="OpenEditBI('${Id}', '${ParentId}', '${RoleId}')">Bingo</li>
        {{/if}} {{if RoleId == 4 || RoleId == 3}}
        <li class="canchange" onclick="OpenEditTransferTime('${Id}',${IsAgent});">Transfer Condition</li>
        {{else}} {{if RoleId == 2 && IsDirectMaster}}
        <li class="canchange" onclick="OpenEditTransferTime('${Id}',${IsAgent});">Transfer Condition</li>
        {{/if}} {{/if}}
        <li class="canchange" onclick="OpenChangePwd('${Id}','${UserName}');">Password</li>
        {{if VisibleP2PSetting}}
        <li class="canchange" onclick="editSetting('${Id}', '${RoleId}');">Poker</li>
        {{/if}} {{if EnableLiveCasino}}
        <li class="canchange" onclick="liveCasinoSetting('${Id}', '0', '${ParentId}');">Live
            Casino</li>
        {{/if}}
    </ul>
</div>
