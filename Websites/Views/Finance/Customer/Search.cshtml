<table class="l">
    <tbody>
        <tr>
            <td>
                <font class="b">Keyword:</font>
            </td>
            <td>
                <input type="text" id="txtSearch" class="txt" placeholder="All">
            </td>
            <td>
                <font class="b">First Letter:</font>
            </td>
            <td>
                <select id="listAlpha" name="listAlpha" class="w60">
                    <option value="All">All</option>
                    <option value="0-9">0-9</option>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                    <option value="E">E</option>
                    <option value="F">F</option>
                    <option value="G">G</option>
                    <option value="H">H</option>
                    <option value="I">I</option>
                    <option value="J">J</option>
                    <option value="K">K</option>
                    <option value="L">L</option>
                    <option value="M">M</option>
                    <option value="N">N</option>
                    <option value="O">O</option>
                    <option value="P">P</option>
                    <option value="Q">Q</option>
                    <option value="R">R</option>
                    <option value="S">S</option>
                    <option value="T">T</option>
                    <option value="U">U</option>
                    <option value="V">V</option>
                    <option value="W">W</option>
                    <option value="X">X</option>
                    <option value="Y">Y</option>
                    <option value="Z">Z</option>
                </select>
            </td>
            <td>
                <font class="b">Currency:</font>
            </td>
            <td>
                <select id="listCurrency" name="listCurrency" class="w60">
                </select>
            </td>
            <td>
                <font class="b">Status:</font>
            </td>
            <td>
                <select id="listType" name="listType" class="w60">
                    <option value="">All</option>
                    <option value="0">Active</option>
                    <option value="1">Closed</option>
                </select>
            </td>
            <td>
                <input type="button" value="Search" id="btnGo" class="btn">
            </td>
        </tr>
    </tbody>
</table>
