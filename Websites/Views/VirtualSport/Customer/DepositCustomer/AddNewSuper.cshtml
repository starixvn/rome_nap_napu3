@using Fanex.Tarus.Infrastructure.Configurations;
@helper GenerateBetSettingVirtualSports()
    {
        var virtualSports = VirtualSportsSection.Instance.Sports;
        var isFirstSport = true;
        foreach (VirtualSportsElement sport in virtualSports)
        {
            if (!sport.Active)
            {
                continue;
            }
            
            var minBetv = "minbetv" + @sport.Id.ToLower();
            var maxBetv = "maxbetv" + @sport.Id.ToLower();
            var maxPerMatchv = "maxpermatchv" + @sport.Id.ToLower();
            var buttonCopyAll = isFirstSport ? "<span><input type=\"checkbox\" class=\"button-copysetting\" title=\"Copy all setting from this\" /></span>" : string.Empty;

            var copyDirection = isFirstSport ? "source=\"true\"" : "target=\"true\"";
            isFirstSport = false;
    <tr>
        <td align="left" style="padding-left: 4px">
            <span>@sport.Name</span>@Html.Raw(buttonCopyAll)
        </td>
        <td>
            <input id="@minBetv" @copyDirection minbet="true" type="text"  style="width: 128px; text-align: right" value="@sport.Minbet" />
        </td>
        <td>
            <input id="@maxBetv" @copyDirection maxbet="true" type="text"  style="width: 128px; text-align: right" value="@sport.Maxbet" />
        </td>
        <td>
            <input id="@maxPerMatchv" @copyDirection maxpermatch="true" type="text"  style="width: 128px; text-align: right" value="@sport.Maxpermatch" />
        </td>
    </tr>
        }
}
<table id="tblTabVirtualSports" cellspacing="0" cellpadding="0" border="0" class="tblPTheader"
    style="margin-top: 15px">
    <tbody>
        <tr id="btntop" style="cursor: pointer;">
            <td class="btnleft">
            </td>
            <td width="80" align="left" class="btnmiddle">
                <span class="mp">Virtual Sports</span>
            </td>
            <td width="20" class="md2 r" arrow="true">
            </td>
            <td class="btnright">
            </td>
        </tr>
    </tbody>
</table>
<div id="divVirtualSportsContainer">
    <table border="0">
        <tbody>
            <tr>
                <td align="left">
                    <input id="cbxEnableVirtualSports" type="checkbox" />
                </td>
                <td>
                    <label style="font-weight: bold" for="cbxEnableVirtualSports">
                        Enable Virtual Sports</label>
                </td>
            </tr>
        </tbody>
    </table>
    <table class="tblcollapse" style="width: 520px; margin-left: 7px">
        <tbody>
            <tr class="title">
                <td colspan="4" align="center">
                    <span style="font-weight: bold">Bet Setting</span>
                </td>
            </tr>
            <tr class="title">
                <td style="width: 130px">
                </td>
                <td style="width: 130px" align="center">
                    <span style="font-weight: bold">Min Bet</span>
                </td>
                <td style="width: 130px" align="center">
                    <span style="font-weight: bold">Max Bet</span>
                </td>
                <td style="width: 130px" align="center">
                    <span style="font-weight: bold">Max Per Match</span>
                </td>
            </tr>
            @GenerateBetSettingVirtualSports()
        </tbody>
    </table>
    <table class="tblcollapse" style="width: 520px; margin-left: 7px; margin-top: 15px">
        <tbody>
            <tr class="title">
                <td colspan="2" align="center">
                    <span style="font-weight: bold">Position Taking</span>
                </td>
            </tr>
            <tr>
                <td align="left" style="padding-left: 4px; width: 100px">
                    <span>Virtual Sports</span>
                </td>
                <td style="" align="left">
                    <select id="selVirtualSportsPT" style="width: 60px; text-align: left">
                    </select>
                </td>
            </tr>
        </tbody>
    </table>
</div>
@{
    var virtualSports = VirtualSportsSection.Instance.Sports;
}
<script type="text/javascript">
    var virtualSports = [];
    (function () {
    @{
        @:var sport;
        foreach (VirtualSportsElement sport in virtualSports)
        {
            if (!sport.Active)
            {
                continue;
            }
            @:sport = {Id: '@sport.Id.ToLower()', Bettype: [], Name: '@sport.Name'};
            if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
            {
                if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                {
                    var bettypes = sport.Bettype.Split(new char[] { ',' });
                    foreach (var bettype in bettypes)
                    {
                       @:sport.Bettype.push(@bettype);
                    }
                }
            }
            @:window.virtualSports.push(sport);
        }
    }
    })();
</script>
<script src="~/Views/VirtualSport/Customer/DepositCustomer/js/Common.js" type="text/javascript"></script>
<script src="~/Views/VirtualSport/Customer/DepositCustomer/js/AddNewSuper.js" type="text/javascript"></script>
