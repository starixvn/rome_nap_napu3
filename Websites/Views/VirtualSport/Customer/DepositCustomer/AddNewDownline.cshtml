@using Fanex.Tarus.Infrastructure.Configurations;
<table id="tblTabVirtualSports" cellspacing="0" cellpadding="0" border="0" class="tblPTheader"
    style="margin-top: 15px">
    <tbody>
        <tr id="btntop" style="cursor: pointer;">
            <td class="btnleft">
            </td>
            <td width="80" align="left" class="btnmiddle">
                <span class="mp">Virtual Sports</span>
            </td>
            <td width="20" class="md2 r" arrow="true">
            </td>
            <td class="btnright">
            </td>
        </tr>
    </tbody>
</table>
<div id="divVirtualSportsContainer">
    <table class="tblcollapse" style="width: 660px; margin-left: 7px" id="tblSettingLimit">
        <tbody>
        </tbody>
    </table>
    <table class="tblcollapse" style="width: 660px; margin-left: 7px; margin-top: 15px">
        <tbody>
            <tr class="title">
                <td colspan="2" align="center">
                    <span style="font-weight: bold">Position Taking</span>
                </td>
            </tr>
            <tr>
                <td align="left" style="padding-left: 4px;width: 100px">
                    <span>Virtual Sports</span>
                </td>
                <td style="" align="left">
                    <select id="selVirtualSportsPT" style="width: 60px; text-align:left">
                    </select>
                </td>                
            </tr>
        </tbody>
    </table>
</div>

@{
    var virtualSports = VirtualSportsSection.Instance.Sports;
}
<script type="text/javascript">
    var virtualSports = [];
    (function () {
    @{
        @:var sport;
        foreach (VirtualSportsElement sport in virtualSports)
        {
            if (!sport.Active)
            {
                continue;
            }
            @:sport = {Id: '@sport.Id.ToLower()', Bettype: [], Name: '@sport.Name'};
            if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
            {
                if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                {
                    var bettypes = sport.Bettype.Split(new char[] { ',' });
                    foreach (var bettype in bettypes)
                    {
                       @:sport.Bettype.push(@bettype);
                    }
                }
            }
            @:window.virtualSports.push(sport);
        }
    }
    })();
</script>

<script src="~/Views/VirtualSport/Customer/DepositCustomer/js/Common.js" type="text/javascript"></script>
<script src="~/Views/VirtualSport/Customer/DepositCustomer/js/AddNewDownline.js" type="text/javascript"></script>