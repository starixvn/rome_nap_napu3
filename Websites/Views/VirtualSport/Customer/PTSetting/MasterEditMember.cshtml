@using Fanex.PTVirtualSports

<link rel="Stylesheet" href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.Core.css")" />
<link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
<link rel="Stylesheet" href="@Url.Content("~/Views/VirtualSport/Customer/PTSetting/Styles/StyleSheet.css")" />
@*PT Engine Script*@
<script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery-1.7.js")"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.Core.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.BettingLimit.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.BetType.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.GridHeader.js")"></script>
<script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTVirtualSports.UI.Languages.en.js")"></script>
@*End PT Engine Script*@
<script type="text/javascript" src="@Url.Content("~/js/jQuery/json2.js")"></script>
<script type="text/javascript" src="@Url.Content("~/js/BlockUI.js")"></script>
<script src="~/js/jQuery/knockout/knockout-2.0.0.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Views/VirtualSport/Customer/PTSetting/Js/MasterEditMember.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Views/VirtualSport/Customer/PTSetting/Js/CommonPT.js")"></script>
<script type="text/javascript">
    var masterId = @Request["masterId"] ? @Request["masterId"] : 0;
    var MemberId = @Request["custId"] ? @Request["custId"] : 0;
</script>
<div class="maincontent">
    <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
        <tr>
            <td class="maincontent_headerL">
            </td>
            <td class="maincontent_headerC fixfont">
                Update Member
            </td>
            <td class="maincontent_headerR">
            </td>
        </tr>
    </table>
    <div id="divShowInfo" class="maincontent_box" style="width: 844px;">
        <div id="err" class="errMsg">
        </div>
        <div id="errMsg" class="error-message">
        </div>
    </div>
    <div class="bg_table" style="width: 844px;">
        @Html.Partial("~/Views/VirtualSport/Customer/PTSetting/CustomerInfo.cshtml")
        
        <table class="tblcollapse" style="width: 840px; margin-top: 5px; margin-bottom: 5px;">
            <tr class="title">
                <td>
                    Bet Setting
                </td>
            </tr>
            <tr>
                <td>
                    <div id="bettingLimitContainer"></div>
                </td>
            </tr>
        </table>

        <table class="tblcollapse" style="width: 840px; margin-top: 5px; margin-bottom: 5px;">
            <tr class="title">
                <td>
                    Position Taking
                </td>
            </tr>
            <tr>
                <td>
                    <div id="ptContainer"></div>
                </td>
            </tr>
        </table>
        <table cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td class="custBtn1">
                    </td>
                    <td onclick="return vsCustomer.updateMember();" id="btnAdd" class="custBtn2 hand">
                        Update
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>